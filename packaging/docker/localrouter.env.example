# Copy this file outside the repository or to an ignored `.env` file.
# Use the private address assigned to this LocalRouter host, not 0.0.0.0.
LOCALROUTER_LAN_HOST=192.168.1.10
LOCALROUTER_LAN_PORT=8318
LOCALROUTER_LOCAL_PORT=8317

# Set these only when compose.bind.yaml should reuse an existing native install.
# LOCALROUTER_CONFIG_DIR=/absolute/path/to/config/localrouter
# LOCALROUTER_DATA_DIR=/absolute/path/to/data/localrouter
# LOCALROUTER_STATE_DIR=/absolute/path/to/state/localrouter
# LOCALROUTER_CACHE_DIR=/absolute/path/to/cache/localrouter

# Optional exact browser origins allowed to call the LAN service surface.
# This never exposes the console or maintenance APIs.
# LOCALROUTER_LAN_ALLOWED_ORIGINS=https://agent-ui.home.arpa,http://192.168.1.20:3000

# Optional immutable published image reference.
# LOCALROUTER_IMAGE=ghcr.io/owner/localrouter@sha256:replace-with-reviewed-digest
