[Unit]
Description=LocalRouter loopback AI and API gateway
Documentation=http://127.0.0.1:8317/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@EXEC_START@
EnvironmentFile=-%E/localrouter/config.env
Restart=on-failure
RestartSec=2s
TimeoutStopSec=35s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
