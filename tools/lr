#!/usr/bin/env bash
set -euo pipefail

base_url="${LOCALROUTER_BASE_URL:-http://127.0.0.1:8317}"
base_url="${base_url%/}"
discovery_url="${LOCALROUTER_DISCOVERY_URL:-$base_url/.well-known/localrouter.json}"
mcp_url="${LOCALROUTER_MCP_URL:-$base_url/mcp}"
maintenance_mcp_url="${LOCALROUTER_MAINTENANCE_MCP_URL:-http://127.0.0.1:8317/manage/mcp}"
allow_lan="${LOCALROUTER_ALLOW_LAN:-false}"
xdg_data_home="${XDG_DATA_HOME:-${HOME:?HOME is required}/.local/share}"
[[ "$xdg_data_home" = /* ]] || xdg_data_home="$HOME/.local/share"
default_api_token_file="$xdg_data_home/localrouter/api-token"
default_admin_token_file="$xdg_data_home/localrouter/admin-token"
api_token_file="${LOCALROUTER_API_TOKEN_FILE:-$default_api_token_file}"
admin_token_file="${LOCALROUTER_ADMIN_TOKEN_FILE:-$default_admin_token_file}"
maintainer_token_file="${LOCALROUTER_MAINTAINER_TOKEN_FILE:-}"

# Recover only the retired repository-local locators used before the XDG install.
# Other explicit locator failures remain authoritative instead of silently falling back.
legacy_project_root="${LOCALROUTER_PROJECT_ROOT:-}"
legacy_project_root="${legacy_project_root%/}"
if [[ -n "$legacy_project_root" ]]; then
  if [[ "$api_token_file" == "$legacy_project_root/gateway/data/api-token" && ! -e "$api_token_file" && -f "$default_api_token_file" ]]; then
    api_token_file="$default_api_token_file"
  fi
  if [[ "$admin_token_file" == "$legacy_project_root/gateway/data/admin-token" && ! -e "$admin_token_file" && -f "$default_admin_token_file" ]]; then
    admin_token_file="$default_admin_token_file"
  fi
fi

usage() {
  cat <<'EOF'
Usage: lr <command> [arguments]

Start here
  lr init                           Check identity and return the next safe step (read-only)
  lr identity request <agent-code> <policy-json|@file>
                                    Request exact scope; human approves once in Agent Workbench
  lr identity claim                 Privately receive and bind the approved identity
  lr identity cancel                Withdraw a pending request before changing its scope
  lr identity access <policy-json|@file>
                                    Request a complete replacement scope; preserves Token and usage
  lr identity access-status <access-id>
                                    Inspect an owned scope change without applying it
  lr identity bind <agent-code> <token-file>
                                    Verify and remember an issued identity for this Agent session
  lr identity forget                Forget this session's locator; never revoke or delete a Token
  lr guide                          Read the short Agent getting-started guide

Discover
  lr status                         Health and compatibility/Protocol Pack readiness
  lr tree [pack]                    Show all LR surfaces and Packs as one tree
  lr find <text>                    Search operations, live models and pool metadata
  lr find operation <text>          Search only callable operation contracts
  lr find model [--exact] [--limit N|--all] [text]
                                    Query live model IDs; return at most 20 by default
  lr find pool [text]               Search pool, quota and pricing metadata
  lr models [options] [text]        Precise alias for `lr find model`
  lr pools [text]                   Precise alias for `lr find pool`
  lr catalog [pack] [--limit N|--all]
                                    List operations; return at most 20 by default
  lr resolve <capability> [limit]   Return all exact independent matches as JSON
  lr compare <pack.operation> <pack.operation> [...]
                                    Compare exact operations without merging or choosing one
  lr show <pack>                    Show one compatibility or Protocol Pack
  lr describe <pack> <operation>    Read one compact operation contract; operation_key is accepted
  lr docs <pack>                    Read the Pack's generated Markdown guide
  lr runtime-openai <pack> <model>  Emit the verified OpenAI-compatible base URL and exact model
  lr env                            Show non-secret LocalRouter configuration

Call
  lr result [call-id [--refresh]]    Inspect saved raw response/exit status; refresh queries traces only
  lr exec <pack> <operation> [json] [path-params-json] [query-params-json]
                                    Check identity, exact dynamic model and preflight, then call once
  lr preflight <pack> <operation> [json] [path-params-json] [query-params-json]
                                    Validate auth, readiness and input without an upstream call
  lr call <pack> <operation> [json] [path-params-json] [query-params-json]
                                    Call one operation; path/query values are encoded safely
  lr run <pack> <operation|workflow> [json]
                                    Call an operation or start a persistent workflow
  lr watch <pack> <workflow> <job> [timeout-seconds]
                                    Wait for a terminal job; default timeout is unlimited
  lr cancel <pack> <workflow> <job> Cancel a persistent workflow job
  lr request <method> <path> [json] Call an explicit LocalRouter path
  lr mcp-list [text]                List ready MCP tools, optionally filtered
  lr mcp-call <tool> [json]         Call a ready MCP tool with arguments
  lr whoami                         Show this service Token's non-secret effective policy

Agent-led service setup
  lr setup templates [--all]       List compact template metadata; --all returns full recipes
  lr setup template <id> <version>  Read one exact recipe and its maintenance guide
  lr setup schema                  Read the proposal input schema
  lr setup prepare <json|@file>     Prepare a connection, bundle or template for exact approval
  lr setup list                    List this Agent's proposals
  lr setup get <id>                 Inspect progress, impact, digest and next action
  lr setup verify <id>              Inspect recorded evidence without calling the provider
  lr setup withdraw <id> <digest>   Withdraw an owned pending proposal
  lr setup reconcile <id>           Reconcile an interrupted apply without replaying it
  lr setup bundles                 Inspect bundle revisions and pinned assignments
  lr setup traces [trace-id]        Inspect this Agent's service trace records
  lr setup apply <id> <digest>      Apply a delegated compatible repair; maintenance Token only

Set LOCALROUTER_TASK_ID to correlate calls with an Agent task. Optionally set
LOCALROUTER_TRACE_ID to a 32-character lowercase hexadecimal trace ID. These
labels do not affect identity or permissions. Provider calls are never part of
setup preparation, approval, reconciliation or evidence inspection.

Maintain (Agent lane requires a separate maintenance-only Token)
  lr manage-status                  Show the selected maintenance lane and its prerequisites
  lr manage-list [text]             Inspect semantic maintenance tools; listing grants no authority
  lr manage-call <tool> [json]      Call one semantic draft tool in the selected maintenance lane

JSON may be an inline object or @/path/to/body.json. Service calls read the API
Token. With LOCALROUTER_MAINTAINER_TOKEN_FILE, an Agent must first confirm
maintenance.auth.agent_token.enabled=true in discovery and use a distinct
localrouter.maintain Token. Without that locator, manage commands use the
administrator-backed human operator lane. Agents must not use that fallback or
read the administrator credential; request a distinct maintenance-only Token.
Neither lane permits credential values in output. Do not replace
either lane by editing files, SQLite, live Packs, or restarting the service.

The browser console and /local/api use password-free loopback access by default.
An operator can enable password protection and choose a custom password in
Run Overview. This does not remove the separate administrator credential used
by the human /manage/mcp operator lane.

For an operator-approved private LAN service listener, set
LOCALROUTER_ALLOW_LAN=true and point LOCALROUTER_BASE_URL at its advertised
address. Before reading a Service Token, lr verifies that discovery reports
scope=lan-service and maintenance.available=false. Maintenance URLs remain
loopback-only.

operation_id is a semantic selector for lr/Agent/MCP commands, not an HTTP URL.
Where a command already takes <pack>, <operation> may be either the bare
operation_id or the published pack-qualified operation_key.
For direct HTTP, use the exact call_url published by discovery or lr show.
EOF
}

fail() {
  printf 'lr: %s\n' "$*" >&2
  exit 1
}

json_fail() {
  local code="$1"
  local message="$2"
  local next_action="$3"
  jq -n --arg code "$code" --arg message "$message" --arg next_action "$next_action" '{
    success:false, code:$code, message:$message, reason:$message,
    retryable:false, owner:"agent", retry_after:null,
    next_action:$next_action, alternatives:[]
  }' >&2
  return 1
}

report_curl_failure() {
  local status="$1"
  if [[ "$status" != "22" ]]; then
    printf 'lr: LocalRouter transport failed (curl exit %s); run lr status and verify the loopback discovery URL\n' "$status" >&2
  fi
  return 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command is missing: $1"
}

validate_loopback_url() {
  local candidate_url="$1"
  case "$candidate_url" in
    http://127.0.0.1:*|http://\[::1\]:*) ;;
    *) fail "refusing non-loopback LocalRouter URL: $candidate_url" ;;
  esac
}

url_origin() {
  local candidate_url="$1"
  case "$candidate_url" in
    http://*|https://*) ;;
    *) fail "LocalRouter URL must use http or https: $candidate_url" ;;
  esac
  local authority="${candidate_url#*://}"
  authority="${authority%%/*}"
  [[ -n "$authority" && "$authority" != *"@"* ]] || fail "LocalRouter URL authority is invalid: $candidate_url"
  printf '%s://%s\n' "${candidate_url%%://*}" "$authority"
}

service_url_is_loopback=true
validate_service_urls() {
  case "$base_url" in
    http://127.0.0.1:*|http://\[::1\]:*) ;;
    *)
      service_url_is_loopback=false
      [[ "$allow_lan" == "true" ]] || fail "refusing non-loopback LocalRouter URL without LOCALROUTER_ALLOW_LAN=true: $base_url"
      ;;
  esac
  local base_origin discovery_origin mcp_origin
  base_origin="$(url_origin "$base_url")"
  discovery_origin="$(url_origin "$discovery_url")"
  mcp_origin="$(url_origin "$mcp_url")"
  [[ "$discovery_origin" == "$base_origin" ]] || fail "discovery URL must share the LocalRouter service origin"
  [[ "$mcp_origin" == "$base_origin" ]] || fail "MCP URL must share the LocalRouter service origin"
}

lan_contract_verified=false
verify_lan_contract() {
  [[ "$service_url_is_loopback" == "false" ]] || return 0
  [[ "$lan_contract_verified" == "false" ]] || return 0
  local contract
  contract="$(curl --noproxy '*' --fail-with-body --silent --show-error "$discovery_url")" || report_curl_failure "$?"
  jq -e '.scope == "lan-service" and .maintenance.available == false and .maintenance.scope == "loopback"' >/dev/null <<<"$contract" ||
    fail "refusing to send a Service Token because discovery is not a service-only LAN contract"
  lan_contract_verified=true
}

discovery() {
  if [[ -n "${lr_contract_cache:-}" ]]; then printf '%s\n' "$lr_contract_cache"; return; fi
  curl --noproxy '*' --fail-with-body --silent --show-error "$discovery_url"
}

# Session-scoped locators avoid silently sharing an identity with another Agent
# in the same workspace. No Token value is copied into this binding.
agent_binding_path() {
  local session_key="${LOCALROUTER_AGENT_SESSION:-${CODEX_THREAD_ID:-}}"
  [[ -n "$session_key" ]] || return 1
  local binding_key
  binding_key="$(printf '%s\0%s\0%s' "$base_url" "$PWD" "$session_key" | sha256sum)"
  printf '%s/localrouter/agent-bindings/%s.json' "$xdg_data_home" "${binding_key%% *}"
}

load_agent_binding() {
  [[ -z "${LOCALROUTER_API_TOKEN_FILE:-}" ]] || return 0
  local binding_path
  binding_path="$(agent_binding_path)" || return 0
  [[ -e "$binding_path" || -L "$binding_path" ]] || return 0
  [[ -f "$binding_path" && ! -L "$binding_path" && "$(stat -c '%u:%a' "$binding_path")" = "$EUID:600" ]] || fail "invalid private Agent binding; use lr identity forget or an explicit Service Token locator"
  agent_binding="$(cat "$binding_path")"
  jq -e --arg origin "$base_url" --arg workspace "$PWD" '.origin == $origin and .workspace == $workspace and (.agent_code|type) == "string" and (.token_file|type) == "string" and (.token_file|startswith("/"))' >/dev/null <<<"$agent_binding" || fail "Agent binding does not match this workspace and service origin"
  api_token_file="$(jq -r '.token_file' <<<"$agent_binding")"
}

command_identity() {
  local action="${1:-}" binding_path
  binding_path="$(agent_binding_path)" || fail "set LOCALROUTER_AGENT_SESSION to this Agent's stable session ID; Codex sessions use CODEX_THREAD_ID automatically"
  case "$action" in
    access)
      load_agent_binding
      [[ $# == 2 ]] || fail "use lr identity access <complete-policy-json|@file>"
      local access_identity
      access_identity="$(command_init)" || { printf '%s\n' "$access_identity"; return 1; }
      local access_policy
      access_policy="$(json_argument "$2")"
      local access_response
      access_response="$(authenticated_request POST "$base_url/agent/access-requests" "$(jq -cn --argjson policy "$access_policy" '{policy:$policy}')")" || { printf '%s\n' "$access_response"; return 1; }
      jq '.data + {registration_url:"/#tokens",next_action:"Review the complete replacement scope in Agent Workbench; current policy remains in force until approval."}' <<<"$access_response"
      ;;
    access-status)
      load_agent_binding
      [[ $# == 2 && "$2" =~ ^access-[a-f0-9]{24}$ ]] || fail "use lr identity access-status <access-id>"
      authenticated_request GET "$base_url/agent/access-requests/$2" | jq '.data'
      ;;
    request|claim|cancel)
      command_identity_enroll "$@"
      ;;
    bind)
      [[ $# = 3 && -n "$2" && "$3" = /* ]] || fail "use lr identity bind <agent-code> </absolute/mode-600/token-file>"
      local identity
      identity="$(bearer_request "$3" GET "$base_url/agent/whoami")" || { printf '%s\n' "$identity"; return 1; }
      jq -e --arg agent "$2" --arg workspace "$PWD" '.identity_ready == true and .agent_code == $agent and .workspace == $workspace and .service_access == true and .maintenance_access == false' >/dev/null <<<"$identity" || {
        json_fail "agent_identity_mismatch" "issued identity must match the Agent code and current workspace, and be service-only" "check lr init with the explicit locator; do not borrow another Agent identity or register through /local/api"
        return 1
      }
      local binding_dir="${binding_path%/*}" temporary
      [[ ! -L "$binding_dir" ]] || fail "Agent binding directory cannot be a symlink"
      (umask 077; mkdir -p "$binding_dir")
      [[ "$(stat -c '%u:%a' "$binding_dir")" = "$EUID:700" ]] || fail "Agent binding directory must be private and owned by the current user"
      temporary="$(mktemp "$binding_dir/.binding.XXXXXX")"
      chmod 600 "$temporary"
      jq -n --arg origin "$base_url" --arg workspace "$PWD" --arg agent "$2" --arg token_file "$3" '{origin:$origin,workspace:$workspace,agent_code:$agent,token_file:$token_file}' >"$temporary"
      mv -f -- "$temporary" "$binding_path"
      jq -n --arg agent "$2" --arg workspace "$PWD" '{ready:true,agent_code:$agent,workspace:$workspace,scope:"current-agent-session",token_value_copied:false,next_action:"Use lr exec for an authorized operation; this session now reuses the issued identity automatically."}'
      ;;
    forget)
      [[ $# = 1 ]] || fail "identity forget takes no arguments"
      [[ ! -e "$binding_path" && ! -L "$binding_path" ]] || rm -- "$binding_path"
      printf '{"forgotten":true,"token_deleted":false}\n'
      ;;
    *) fail "use lr identity bind <agent-code> <token-file> or lr identity forget" ;;
  esac
}

# Enrollment has its own private proof and never reads the bootstrap/admin Token.
# Request and claim are resumable; neither can approve the requested authority.
command_identity_enroll() {
  local action="$1" binding_path binding_dir enrollment_dir request_file claim_file response token_file temporary
  [[ "$base_url" =~ ^https?://(127\.0\.0\.1|localhost|\[::1\])(:[0-9]+)?$ ]] || fail "identity enrollment is available only on the loopback operator listener"
  [[ -z "${LOCALROUTER_API_TOKEN_FILE:-}" ]] || fail "unset the explicit Service Token locator before enrolling a new identity; it would override the new binding"
  binding_path="$(agent_binding_path)" || fail "set LOCALROUTER_AGENT_SESSION to this Agent's stable session ID"
  binding_dir="$(dirname "$binding_path")"
  mkdir -p -m 700 "$binding_dir"
  [[ ! -L "$binding_dir" && "$(stat -c '%u:%a' "$binding_dir")" = "$EUID:700" ]] || fail "Agent binding directory must be private and owned by the current user"
  enrollment_dir="${binding_path%.json}.enrollment"
  mkdir -p -m 700 "$enrollment_dir"
  [[ ! -L "$enrollment_dir" && "$(stat -c '%u:%a' "$enrollment_dir")" = "$EUID:700" ]] || fail "enrollment directory must be private and owned by the current user"
  # Serialize one Agent session, including simultaneous resume after a lost response.
  local enrollment_lock
  exec {enrollment_lock}<"$enrollment_dir"
  flock -x "$enrollment_lock"
  request_file="$enrollment_dir/request.json"
  claim_file="$enrollment_dir/claim"
  token_file="$enrollment_dir/service-token"
  if [[ "$action" == request ]]; then
    [[ $# == 3 ]] || fail "use lr identity request <agent-code> <policy-json|@file>; choose exact packs and operations"
    local body policy
    policy="$(json_argument "$3")"
    body="$(jq -cn --arg code "$2" --arg workspace "$PWD" --argjson policy "$policy" '{agent_code:$code,agent_name:$code,workspace:$workspace,runtime:"lr",policy:$policy}')"
    if [[ -e "$request_file" || -L "$request_file" ]]; then
      [[ -f "$request_file" && ! -L "$request_file" && "$(stat -c '%u:%a' "$request_file")" = "$EUID:600" ]] || fail "invalid enrollment request file"
      [[ "$(cat "$request_file")" == "$body" ]] || fail "this session already has a different identity request; resume it, or lr identity cancel before replacing a pending request"
    else
      temporary="$(mktemp "$enrollment_dir/.request.XXXXXX")"
      printf '%s\n' "$body" >"$temporary"
      mv -- "$temporary" "$request_file"
    fi
    if [[ ! -e "$claim_file" && ! -L "$claim_file" ]]; then
      temporary="$(mktemp "$enrollment_dir/.claim.XXXXXX")"
      od -An -N32 -tx1 /dev/urandom | tr -d ' \n' >"$temporary"
      printf '\n' >>"$temporary"
      mv -- "$temporary" "$claim_file"
    fi
    response="$(bearer_request "$claim_file" POST "$base_url/agent/identity-requests" "$body" 30)" || { printf '%s\n' "$response"; return 1; }
    jq --arg url "$base_url/#tokens" '.data + {registration_url:$url,ready:false,next_action:"Review this request once in Agent Workbench, then run lr identity claim. No Token copying is needed."}' <<<"$response"
    return
  fi
  [[ $# == 1 ]] || fail "identity claim/cancel takes no arguments and resumes this Agent session's request"
  [[ -f "$request_file" && ! -L "$request_file" && "$(stat -c '%u:%a' "$request_file")" = "$EUID:600" ]] || fail "no private request for this session; run lr identity request first"
  read_bearer_token "$claim_file"
  local claim_hash request_id agent_code
  claim_hash="$(printf '%s' "$bearer_token" | sha256sum)"
  request_id="identity-${claim_hash:0:24}"
  if [[ "$action" == cancel ]]; then
    response="$(bearer_request "$claim_file" DELETE "$base_url/agent/identity-requests/$request_id" '' 30)" || { printf '%s\n' "$response"; return 1; }
    jq -e '.data.withdrawn == true' >/dev/null <<<"$response" || fail "request withdrawal was not confirmed"
    rm -- "$request_file" "$claim_file"
    jq '.data' <<<"$response"
    return
  fi
  # Keep the secret response only in process memory. Never print raw claim output.
  if ! response="$(bearer_request "$claim_file" POST "$base_url/agent/identity-requests/$request_id/claim" '{}' 30)"; then
    jq '{success:false,code:(.code // "identity_claim_failed"),message:(.message // "credential delivery failed"),next_action:(.next_action // "inspect the existing request; do not create another identity")}' <<<"$response" || true
    return 1
  fi
  if ! jq -e '.data.ready == true' >/dev/null <<<"$response"; then
    jq '.data | del(.token)' <<<"$response"
    return 1
  fi
  jq -e --argjson request "$(cat "$request_file")" '.data.request.agent_code == $request.agent_code and .data.request.workspace == $request.workspace and (.data.token | test("^sk-[A-Za-z0-9_-]+$"))' >/dev/null <<<"$response" || fail "credential response does not match the pending identity"
  temporary="$(mktemp "$enrollment_dir/.token.XXXXXX")"
  jq -r '.data.token' <<<"$response" >"$temporary"
  mv -f -- "$temporary" "$token_file"
  agent_code="$(jq -r '.data.request.agent_code' <<<"$response")"
  command_identity bind "$agent_code" "$token_file"
}

read_bearer_token() {
  local token_file="$1"
  [[ -f "$token_file" && ! -L "$token_file" ]] || fail "token file is not a regular file: $token_file"
  [[ "$(stat -c '%u' "$token_file")" = "$EUID" ]] || fail "token file is not owned by the current user"
  [[ "$(stat -c '%a' "$token_file")" = "600" ]] || fail "token file must have mode 0600"
  local token_line_count
  token_line_count="$(wc -l <"$token_file")"
  [[ "$token_line_count" = "1" ]] || fail "token file must contain exactly one line"
  IFS= read -r bearer_token <"$token_file"
  [[ -n "$bearer_token" ]] || fail "token file is empty"
}

curl_config_with_auth() {
  local escaped_token="$bearer_token"
  escaped_token="${escaped_token//\\/\\\\}"
  escaped_token="${escaped_token//\"/\\\"}"
  printf 'header = "Authorization: Bearer %s"\n' "$escaped_token"
  printf 'header = "Accept: application/json"\n'
}

curl_config_with_admin_auth() {
  local escaped_token="$bearer_token"
  escaped_token="${escaped_token//\\/\\\\}"
  escaped_token="${escaped_token//\"/\\\"}"
  printf 'header = "X-Local-Admin: %s"\n' "$escaped_token"
  printf 'header = "Accept: application/json"\n'
}

bearer_request() {
  local token_file="$1"
  local method="$2"
  local request_url="$3"
  local body="${4:-}"
  local max_time_seconds="${5:-}"
  local response_output="${6:-}"
  local curl_arguments=(--noproxy '*' --config /dev/fd/3 --fail-with-body --silent --no-buffer --request "$method")
  if [[ -n "$response_output" ]]; then
    curl_arguments+=(--output "$response_output" --write-out '%{http_code}')
  fi
  if [[ -n "${LOCALROUTER_TASK_ID:-}" ]]; then
    [[ "$LOCALROUTER_TASK_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$ ]] || fail "invalid LOCALROUTER_TASK_ID"
    curl_arguments+=(--header "X-LocalRouter-Task-Id: $LOCALROUTER_TASK_ID")
  fi
  if [[ -n "${LOCALROUTER_TRACE_ID:-}" ]]; then
    [[ "$LOCALROUTER_TRACE_ID" =~ ^[a-f0-9]{32}$ && "$LOCALROUTER_TRACE_ID" != 00000000000000000000000000000000 ]] || fail "invalid LOCALROUTER_TRACE_ID"
    curl_arguments+=(--header "X-LocalRouter-Trace-Id: $LOCALROUTER_TRACE_ID")
  fi
  if [[ -n "$max_time_seconds" ]]; then
    [[ "$max_time_seconds" =~ ^[0-9]+$ ]] && ((10#$max_time_seconds >= 1 && 10#$max_time_seconds <= 120)) ||
      fail "request timeout must be between 1 and 120 seconds"
    curl_arguments+=(--connect-timeout 5 --max-time "$max_time_seconds")
  fi
  if [[ -n "$body" && "$method" != "GET" && "$method" != "HEAD" ]]; then
    curl_arguments+=(--header 'Content-Type: application/json' --data-binary @-)
  fi
  verify_lan_contract
  read_bearer_token "$token_file"
  if [[ -n "$body" && "$method" != "GET" && "$method" != "HEAD" ]]; then
    curl "${curl_arguments[@]}" "$request_url" 3< <(curl_config_with_auth) <<<"$body" || report_curl_failure "$?"
    return
  fi
  curl "${curl_arguments[@]}" "$request_url" 3< <(curl_config_with_auth) || report_curl_failure "$?"
}

authenticated_request() {
  bearer_request "$api_token_file" "$@"
}

maintenance_request() {
  if [[ -n "$maintainer_token_file" ]]; then
    bearer_request "$maintainer_token_file" "$@"
    return
  fi
  local method="$1"
  local request_url="$2"
  local body="${3:-}"
  local curl_arguments=(--noproxy '*' --config /dev/fd/3 --fail-with-body --silent --request "$method")
  if [[ -n "$body" && "$method" != "GET" && "$method" != "HEAD" ]]; then
    curl_arguments+=(--header 'Content-Type: application/json' --data-binary @-)
  fi
  read_bearer_token "$admin_token_file"
  if [[ -n "$body" && "$method" != "GET" && "$method" != "HEAD" ]]; then
    curl "${curl_arguments[@]}" "$request_url" 3< <(curl_config_with_admin_auth) <<<"$body" || report_curl_failure "$?"
    return
  fi
  curl "${curl_arguments[@]}" "$request_url" 3< <(curl_config_with_admin_auth) || report_curl_failure "$?"
}

validate_local_path() {
  local request_path="$1"
  [[ "$request_path" == /* && "$request_path" != //* && "$request_path" != *://* ]] || fail "path must be a LocalRouter-relative path beginning with one slash"
}

json_argument() {
  local input="${1-}"
  [[ -n "$input" ]] || input='{}'
  if [[ "$input" == @* ]]; then
    local json_file="${input#@}"
    [[ -f "$json_file" ]] || fail "JSON file not found: $json_file"
    jq -c . "$json_file"
  else
    jq -c . <<<"$input"
  fi
}

command_status() {
  local health_json discovery_json
  health_json="$(curl --noproxy '*' --fail-with-body --silent --show-error "$base_url/healthz")"
  discovery_json="$(discovery)"
  jq -n --argjson health "$health_json" --argjson contract "$discovery_json" '{
    health: $health,
    console: (if $contract.scope == "loopback" then {
      available: true, url: "/",
      auth_enabled: ($contract.maintenance.console_auth.enabled // false),
      default_auth_enabled: ($contract.maintenance.console_auth.default_enabled // false)
    } else {available:false, url:null, scope:"loopback-only"} end),
    compatibility_packs: [$contract.compatibility_packs[]? | {
      id, kind, status, ready, mounts,
      operations: (.routes | length),
      pool: {mode: .pool.mode, eligible: .pool.eligible}
    }],
    protocols: [$contract.protocols[] | {
      id, status, ready, mount,
      operations: (.routes | length),
      pool: (if .pool then {mode: .pool.mode, source: .pool.source, total: .pool.total, eligible: .pool.eligible} else null end)
    }]
  }'
}

command_tree() {
  local pack_id="${1:-}"
  if [[ -n "$pack_id" ]]; then
    validate_pack_id "$pack_id"
  fi
  local contract
  contract="$(discovery)"
  jq -r --arg filter "$pack_id" --arg root "$base_url" '
    [(.compatibility_packs // [])[] | select($filter == "" or .id == $filter) | . + {_node_kind:"compatibility"}] as $compatibility
    | [(.protocols // [])[] | select($filter == "" or .id == $filter) | . + {_node_kind:"protocol"}] as $protocols
    | (if $filter == "" then [(.surfaces // [])[] | . + {_node_kind:"surface"}] else [] end) as $surfaces
    | ($surfaces + $compatibility + $protocols) as $nodes
    | if ($compatibility | length) + ($protocols | length) == 0 and $filter != "" then error("unknown Pack: " + $filter) else . end
    | "LocalRouter " + $root + "  topology=" + (.topology.schema_version // "?") + ":" + ((.topology.digest // "missing")[0:12]),
      ($nodes | to_entries[]
        | .key as $node_index
        | .value as $node
        | ($node_index == (($nodes | length) - 1)) as $last_node
        | (if $last_node then "└─ " else "├─ " end) as $branch
        | (if $last_node then "   " else "│  " end) as $indent
        | if $node._node_kind == "surface" then
            $branch + "surface " + $node.id + "  " + (($node.paths // []) | join(", ")) + " — " + ($node.role // "")
          elif $node._node_kind == "compatibility" then
            $branch + $node.id + " [compatibility:" + ($node.status // "unknown") + "] " + ($node.name // ""),
            $indent + "├─ mount  " + (($node.mounts // []) | join(", ")),
            $indent + "├─ pool   channels eligible=" + (($node.pool.eligible // 0) | tostring),
            (($node.routes // []) | to_entries[]
              | $indent
                + (if .key == ((($node.routes // []) | length) - 1) then "└─ " else "├─ " end)
                + "api " + ((.value.methods // []) | join("/")) + " " + (.value.call_url // .value.path)
                + (if .value.status == "unsupported" then " [unsupported]" else "" end))
          else
            $branch + $node.id + " [protocol:" + ($node.status // "unknown") + "] " + ($node.name // ""),
            $indent + "├─ mount  " + ($node.mount // "unknown"),
            (if ($node.openai_v1_base_url // "") != "" then $indent + "├─ openai " + $node.openai_v1_base_url else empty end),
            (if $node.pool then
               $indent + "├─ pool   " + ($node.pool.mode // "static")
               + (if ($node.pool.source // "") != "" then "/" + $node.pool.source else "" end)
               + (if $node.pool.total != null then " eligible=" + (($node.pool.eligible // 0) | tostring) + "/" + ($node.pool.total | tostring) else "" end)
             else empty end),
            (($node.routes // []) | to_entries[]
              | $indent
                + (if (.key == ((($node.routes // []) | length) - 1)) and (($node.workflows // []) | length) == 0 then "└─ " else "├─ " end)
                + "op " + (.value.operation_key // ($node.id + "." + .value.operation_id))
                + "  " + ((.value.methods // []) | join("/")) + " " + (.value.call_url // .value.path)
                + (if (.value.transport // "http") != "http" then " [" + .value.transport + "]" else "" end)),
            (($node.workflows // []) | to_entries[]
              | $indent
                + (if .key == ((($node.workflows // []) | length) - 1) then "└─ " else "├─ " end)
                + "wf " + .value.id + "  POST " + ($node.workflow_mount + "/" + .value.id))
          end),
      "",
      "Next: lr show <pack>; Protocol Pack → lr describe/preflight/call/run; compatibility Pack → lr request"
  ' <<<"$contract"
}

command_find_operation() {
  local search_text="${1:-}"
  [[ -n "$search_text" ]] || fail "operation search requires text; use 'lr catalog' for the complete list"
  discovery | jq --arg query "$search_text" '
    def words:
      ascii_downcase | gsub("[^[:alnum:]]+"; " ") | split(" ")
      | map(select(length > 1 and . != "for" and . != "the" and . != "with" and . != "agent"));
    ($query | words) as $terms
    | ($terms | map(select(. != "free" and . != "quota" and . != "model" and . != "coding" and . != "omp"))) as $specific_terms
    | (if ($specific_terms | length) > 0 then $specific_terms else $terms end) as $search_terms
    | [.protocols[] as $protocol
      | $protocol.routes[]
      | ([
          $protocol.id, $protocol.name, $protocol.description,
          .operation_key, .operation_id, .path, .call_url, .summary,
          ((.capabilities // []) | join(" "))
        ] | join(" ") | ascii_downcase) as $haystack
      | ([ $search_terms[] | . as $term | select($haystack | contains($term)) ] | length) as $score
      | select($score > 0)
      | {
          score: $score,
          operation_key, operation_id, pack: $protocol.id,
          capabilities: (.capabilities // []), methods, call_url,
          ready: $protocol.ready, status: $protocol.status, summary
        }
    ]
    | sort_by([-.score, .operation_key])
    | {
        object: "localrouter.operation.search",
        domain: "operation",
        query: $query,
        count: length,
        matches: .,
        exact_next_step: "choose an operation_key, then run lr describe <pack> <operation> and lr preflight",
        boundary: "operation search does not search model IDs, quota, pricing, or Agent runtime configuration"
      }
  '
}

command_find_model() {
  local search_text="${1:-}"
  local result_limit="${2:-20}"
  local exact_only="${3:-false}"
  local requested_pack=""
  if [[ "$exact_only" == "true" && "$search_text" == *:* ]]; then
    requested_pack="${search_text%%:*}"
    [[ "$requested_pack" =~ ^[a-z0-9][a-z0-9._-]*$ && -n "${search_text#*:}" ]] ||
      fail "exact model selection must use <pack>:<model-id>"
  fi
  local catalog_timeout="${LOCALROUTER_MODEL_CATALOG_TIMEOUT_SECONDS:-10}"
  [[ "$catalog_timeout" =~ ^[0-9]+$ ]] && ((10#$catalog_timeout >= 1 && 10#$catalog_timeout <= 120)) ||
    fail "LOCALROUTER_MODEL_CATALOG_TIMEOUT_SECONDS must be between 1 and 120"
  local contract search_tmp model_rows source_rows failure_rows
  contract="$(discovery)"
  search_tmp="$(mktemp -d "${TMPDIR:-/tmp}/localrouter-model-search.XXXXXX")"
  chmod 0700 "$search_tmp"
  model_rows="$search_tmp/models.jsonl"
  source_rows="$search_tmp/sources.jsonl"
  failure_rows="$search_tmp/failures.jsonl"
  : >"$model_rows"
  : >"$source_rows"
  : >"$failure_rows"
  if [[ -n "$requested_pack" ]]; then
    jq -c --arg pack "$requested_pack" '
      [.protocols[] | select(.id == $pack)] as $packs
      | if ($packs|length) == 0 then
          {pack:$pack,code:"pack_not_found",reason:"selected Pack is not published",next_action:"use lr tree to select a published Pack"}
        elif $packs[0].ready != true then
          {pack:$pack,code:"pack_not_ready",status:$packs[0].status,reason:"selected Pack is not ready for model discovery",next_action:"inspect lr status and lr show for this Pack before querying models"}
        else empty end
    ' <<<"$contract" >>"$failure_rows"
  fi
  jq -c --arg requested_pack "$requested_pack" '
    .protocols[] as $protocol
    | select($protocol.ready == true)
    | select($requested_pack == "" or $protocol.id == $requested_pack)
    | $protocol.routes[] as $route
    | $route.dynamic_inputs[]?
    | select(.source_kind == "request-schema-enum")
    | (.allowed_values // [])[]
    | {
        id: ., pack: $protocol.id, pack_name: $protocol.name,
        pack_description: $protocol.description,
        source_kind: "request-schema-enum", source_operation_key: null,
        model_key: ($protocol.id + ":" + .)
      }
  ' <<<"$contract" >>"$model_rows"
  jq -c --arg requested_pack "$requested_pack" '
    .protocols[] as $protocol
    | select($protocol.ready == true)
    | select($requested_pack == "" or $protocol.id == $requested_pack)
    | $protocol.routes[] as $route
    | $route.dynamic_inputs[]?
    | select(.source_kind == "request-schema-enum" and ((.allowed_values // []) | length) > 0)
    | {
        pack: $protocol.id, operation_key: $route.operation_key,
        call_url: null, status: "contract", source_kind: "request-schema-enum",
        models: (.allowed_values | length)
      }
  ' <<<"$contract" >>"$source_rows"
  while IFS=$'\t' read -r pack_id pack_name pack_description operation_key call_url; do
    [[ -n "$pack_id" ]] || continue
    local response parsed http_status request_exit=0
    : >"$search_tmp/response.json"
    http_status="$(authenticated_request GET "$base_url$call_url" '' "$catalog_timeout" "$search_tmp/response.json" 2>"$search_tmp/request.stderr")" || request_exit=$?
    response="$(cat "$search_tmp/response.json" 2>/dev/null || true)"
    if [[ "$request_exit" = 0 ]] && parsed="$(jq -c '
      if (.data | type) == "array" then .data
      elif (.models | type) == "array" then .models
      else error("unrecognized model catalog response") end
      | map(
          if type == "string" then {id: .}
          elif type == "object" then . + {
            id: (.id // .model_cls // .model // (if (.name | type) == "string" then .name else "" end)),
            owned_by: (.owned_by // .provider // .task // null)
          }
          else {id: ""} end
        )
      | map(select((.id | type) == "string" and .id != ""))
    ' <<<"$response" 2>/dev/null)"; then
      jq -cn --arg pack "$pack_id" --arg operation_key "$operation_key" --arg call_url "$call_url" --argjson count "$(jq 'length' <<<"$parsed")" '{pack:$pack,operation_key:$operation_key,call_url:$call_url,status:"ok",models:$count}' >>"$source_rows"
      jq -c --arg pack "$pack_id" --arg pack_name "$pack_name" --arg description "$pack_description" --arg operation_key "$operation_key" '.[] | . + {pack:$pack,pack_name:$pack_name,pack_description:$description,operation_key:$operation_key,source_kind:"catalog-operation",model_key:($pack + ":" + .id)}' <<<"$parsed" >>"$model_rows"
    else
      # Preserve the gateway's structured reason instead of treating every
      # failure as an empty model catalogue. Never print an arbitrary upstream
      # body, curl diagnostic, credential, or private trace header here.
      local detail='{}'
      detail="$(jq -ce 'select(.success == false and (.code|type) == "string") | with_entries(select(.key as $key | ["code","message","reason","retryable","owner","retry_after","next_action","alternatives"] | index($key)))' <<<"$response" 2>/dev/null)" || detail='{}'
      jq -cn --arg pack "$pack_id" --arg operation_key "$operation_key" --arg call_url "$call_url" --arg http_status "$http_status" --argjson request_exit "$request_exit" --argjson detail "$detail" '
        {pack:$pack,operation_key:$operation_key,call_url:$call_url,http_status:($http_status|tonumber? // null),request_exit_code:$request_exit}
        + (if ($detail|length)>0 then $detail else {
            code:(if $request_exit == 0 then "model_catalog_invalid_response" else "model_catalog_request_failed" end),
            reason:(if $request_exit == 0 then "model catalog response is not a supported catalogue object" else "model catalog request failed; inspect http_status and the provider readiness" end),
            next_action:"resolve the catalogue failure before selecting a model; do not treat this response as model absence"
          } end)
      ' >>"$failure_rows"
    fi
  done < <(jq -r --arg requested_pack "$requested_pack" '
    .protocols[] as $protocol
    | select($protocol.ready == true)
    | select($requested_pack == "" or $protocol.id == $requested_pack)
    | $protocol.routes[]
    | select((.capabilities // []) | any(. == "ai.models" or . == "openai.models" or . == "media.models"))
    | select((.methods // []) | index("GET"))
    | [$protocol.id, $protocol.name, $protocol.description, .operation_key, .call_url] | @tsv
  ' <<<"$contract")

  if [[ -n "$requested_pack" && ! -s "$source_rows" && ! -s "$failure_rows" ]]; then
    jq -cn --arg pack "$requested_pack" '{pack:$pack,code:"model_catalog_unavailable",reason:"selected Pack publishes neither a model catalogue nor a model schema enum",next_action:"inspect lr describe for the supported dynamic inputs; no model availability was inferred"}' >>"$failure_rows"
  fi

  local output
  output="$(jq -n \
    --arg query "$search_text" \
    --argjson result_limit "$result_limit" \
    --argjson exact_only "$exact_only" \
    --argjson contract "$contract" \
    --slurpfile models "$model_rows" \
    --slurpfile sources "$source_rows" \
    --slurpfile failures "$failure_rows" '
      def words:
        ascii_downcase | gsub("[^[:alnum:]]+"; " ") | split(" ")
        | map(select(length > 1 and . != "for" and . != "the" and . != "with" and . != "agent" and . != "model"));
      ($query | ascii_downcase) as $normalized_query
      | ($query | words) as $terms
      | ($terms | map(select(. != "free" and . != "quota" and . != "coding" and . != "omp"))) as $specific_terms
      | (if ($specific_terms | length) > 0 then $specific_terms else $terms end) as $identity_terms
      | ($models | unique_by(.model_key) | map(
          ([.pack, .id, (.owned_by // "")] | join(" ") | ascii_downcase) as $identity_haystack
          | ([.pack_description] | join(" ") | ascii_downcase) as $context_haystack
          | ([ $identity_terms[] | . as $term | select($identity_haystack | contains($term)) ] | length) as $identity_score
          | ([ $terms[] | . as $term | select($context_haystack | contains($term)) ] | length) as $context_score
          | . as $model
          | . + {
              score:($identity_score * 10 + $context_score),
              identity_score:$identity_score,
              compatible_operations: [
                $contract.protocols[]
                | select(.id == $model.pack and .ready == true)
                | .routes[]
                | select(any(.dynamic_inputs[]?;
                    (.source_kind == "catalog-operation" and .source_operation_key == $model.operation_key)
                    or (.source_kind == "request-schema-enum" and ((.allowed_values // []) | index($model.id) != null))
                  ))
                | {operation_key, operation_id, methods, call_url, summary}
              ]
            }
        )) as $scored_models
      | ($scored_models | map(select(
          (.id | ascii_downcase) == $normalized_query
          or (.model_key | ascii_downcase) == $normalized_query
        ))) as $exact_matches
      | (if $exact_only then $exact_matches
         elif ($query | length) == 0 then $scored_models
         elif ($exact_matches | length) > 0 then $exact_matches
         else ($scored_models | map(select(.identity_score > 0)))
         end
        | sort_by([-.score, .model_key])) as $all_matches
      | (if $result_limit == 0 then $all_matches else $all_matches[:$result_limit] end) as $matches
      | {
          object: "localrouter.model.search",
          domain: "model",
          query: $query,
          match_mode: (if $exact_only then "exact-only" elif ($query | length) == 0 then "catalog" elif ($exact_matches | length) > 0 then "exact" else "fuzzy" end),
          live: true,
          success: (($failures|length) == 0),
          code: (if ($failures|length)>0 then "model_discovery_incomplete" else null end),
          complete: (($failures|length) == 0),
          count: ($all_matches | length),
          returned: ($matches | length),
          truncated: (($matches | length) < ($all_matches | length)),
          matches: $matches,
          sources: $sources,
          failures: $failures,
          exact_next_step: (if ($failures|length)>0
            then "model discovery is incomplete; inspect failures[].code/reason/next_action before retrying or selecting a model"
            elif $exact_only and ($all_matches | length) == 0
            then "no exact live model matched; refresh with lr find model --exact <pack>:<model-id> or choose a model_key returned by lr find model"
            elif (($matches | length) < ($all_matches | length))
            then "refine the query, increase --limit, or use --all; then choose one model_key and compatible operation before lr describe/preflight"
            else "choose one model_key and one published compatible_operations entry; run lr describe and lr preflight, then confirm pricing/quota with lr find pool <pack>"
            end),
          boundary: "model discovery does not configure OMP or another Agent runtime; pass the explicit Pack endpoint and model ID to that runtime separately"
        }
    ')"
  find "$search_tmp" -depth -delete
  printf '%s\n' "$output"
  [[ "$(jq '.failures|length' <<<"$output")" = 0 ]]
}

command_find_model_cli() {
  local result_limit=20
  local exact_only=false
  local -a query_parts=()
  while (($#)); do
    case "$1" in
      --exact) exact_only=true ;;
      --all) result_limit=0 ;;
      --limit)
        shift
        if [[ ! "${1:-}" =~ ^[0-9]+$ ]] || ((10#${1:-0} < 1 || 10#${1:-0} > 200)); then
          json_fail "invalid_limit" "model result limit must be between 1 and 200" "use --limit 1..200 or --all"
          return 1
        fi
        result_limit="$1"
        ;;
      --*)
        json_fail "invalid_option" "unknown model-search option: $1" "use lr find model [--exact] [--limit N|--all] [text]"
        return 1
        ;;
      *) query_parts+=("$1") ;;
    esac
    shift
  done
  command_find_model "${query_parts[*]}" "$result_limit" "$exact_only"
}

command_find_pool() {
  local search_text="${1:-}"
  local contract pool_catalog_path pool_catalog
  contract="$(discovery)"
  pool_catalog_path="$(jq -r '.documentation.pool_catalog // "/docs/pools/index.json"' <<<"$contract")"
  validate_local_path "$pool_catalog_path"
  pool_catalog="$(curl --noproxy '*' --fail-with-body --silent --show-error "$base_url$pool_catalog_path")"
  jq -n --arg query "$search_text" --argjson contract "$contract" --argjson catalog "$pool_catalog" '
    def words:
      ascii_downcase | gsub("[^[:alnum:]]+"; " ") | split(" ")
      | map(select(length > 1 and . != "for" and . != "the" and . != "with" and . != "agent" and . != "pool"));
    ($query | words) as $terms
    | ($terms | map(select(. != "free" and . != "quota" and . != "model" and . != "coding" and . != "omp"))) as $specific_terms
    | (if ($specific_terms | length) > 0 then $specific_terms else $terms end) as $search_terms
    | (((($catalog.pools // []) | map(.id)) + (($contract.protocols // []) | map(.id))) | unique) as $pool_ids
    | [$pool_ids[] as $pool_id
      | (($catalog.pools // []) | map(select(.id == $pool_id)) | first // {id:$pool_id,status:"uncatalogued",adapter:"unknown",owner:"unknown",note:"Live Pack is not indexed in the static pool catalog."}) as $pool
      | (($contract.protocols // []) | map(select(.id == $pool_id)) | first // null) as $live
      | ([
          $pool.id, ($pool.status // ""), ($pool.adapter // ""), ($pool.owner // ""), ($pool.note // ""),
          (($pool.pricing // []) | tostring),
          ($live.name // ""), ($live.description // ""), (($live.pool // {}) | tostring), (($live.pricing // {}) | tostring)
        ] | join(" ") | ascii_downcase) as $haystack
      | ([ $search_terms[] | . as $term | select($haystack | contains($term)) ] | length) as $score
      | select(($query | length) == 0 or $score > 0)
      | {
          score: $score,
          pool_id: $pool.id,
          integrated: ($live != null),
          ready: ($live.ready // false),
          runtime_status: ($live.status // "not-integrated"),
          pool: ($live.pool // null),
          catalog_status: ($pool.status // "unknown"),
          adapter: ($pool.adapter // "none"),
          owner: ($pool.owner // "unknown"),
          pricing: ($live.pricing.entries // $pool.pricing // []),
          note: ($pool.note // "")
        }
    ]
    | sort_by([-.score, .pool_id])
    | {
        object: "localrouter.pool.search",
        domain: "pool",
        query: $query,
        count: length,
        matches: .,
        exact_next_step: "inspect ready, pool eligibility, pricing status and quota freshness separately before selecting an operation",
        boundary: "unknown or missing quota is not zero and does not prove a model is free"
      }
  '
}

command_find() {
  local domain="${1:-}"
  if [[ "$domain" == "-h" || "$domain" == "--help" || "${2:-}" == "-h" || "${2:-}" == "--help" ]]; then
    usage
    return 0
  fi
  case "$domain" in
    operation|operations)
      shift
      command_find_operation "$*"
      ;;
    model|models)
      shift
      command_find_model_cli "$@"
      ;;
    pool|pools|quota|pricing)
      shift
      command_find_pool "$*"
      ;;
    "")
      fail "find requires text or a domain: operation, model, pool"
      ;;
    *)
      local search_text="$*" search_tmp operations_file models_file pools_file
      search_tmp="$(mktemp -d "${TMPDIR:-/tmp}/localrouter-resource-search.XXXXXX")"
      chmod 0700 "$search_tmp"
      operations_file="$search_tmp/operations.json"
      models_file="$search_tmp/models.json"
      pools_file="$search_tmp/pools.json"
      command_find_operation "$search_text" >"$operations_file"
      local model_status=0
      command_find_model "$search_text" 20 false >"$models_file" || model_status=$?
      command_find_pool "$search_text" >"$pools_file"
      local output
      output="$(jq -n --arg query "$search_text" --slurpfile operations "$operations_file" --slurpfile models "$models_file" --slurpfile pools "$pools_file" '
        ($operations[0]) as $operation_result | ($models[0]) as $model_result | ($pools[0]) as $pool_result | {
        object:"localrouter.resource.search",
        query:$query,
        domains:{operation:$operation_result,model:$model_result,pool:$pool_result},
        no_match:(($operation_result.count + $model_result.count + $pool_result.count) == 0),
        next_actions:[
          "Use lr find operation <intent> for callable capabilities",
          "Use lr find model <name> for current upstream model IDs",
          "Use lr find pool <provider> for readiness, quota and pricing",
          "Configure OMP or another Agent runtime only after choosing an exact operation_key and model_key"
        ]
      }')"
      find "$search_tmp" -depth -delete
      printf '%s\n' "$output"
      return "$model_status"
      ;;
  esac
}

validate_pack_id() {
  local value="$1"
  [[ "$value" =~ ^[a-z][a-z0-9-]{1,31}$ ]] || fail "invalid Pack ID: $value"
}

validate_operation_id() {
  local value="$1"
  [[ "$value" =~ ^[a-z][a-z0-9._-]{1,63}$ ]] || fail "invalid operation or workflow ID: $value"
}

normalize_operation_selector() {
  local pack_id="$1"
  local selector="$2"
  if [[ "$selector" == "$pack_id".* ]]; then
    selector="${selector#${pack_id}.}"
  fi
  printf '%s\n' "$selector"
}

command_resolve() {
  local query="${1:-}"
  local limit="${2:-100}"
  [[ -n "$query" ]] || fail "resolve requires a capability or intent"
  [[ "$limit" =~ ^[0-9]+$ ]] && ((limit >= 1 && limit <= 200)) || fail "resolve limit must be between 1 and 200"
  local request
  request="$(jq -cn --arg query "$query" --argjson limit "$limit" '{query:$query,limit:$limit}')"
  authenticated_request POST "$base_url/agent/resolve" "$request" | jq .
}

command_catalog() {
  local pack_id=""
  local result_limit=20
  while (($#)); do
    case "$1" in
      --all) result_limit=0 ;;
      --limit)
        shift
        if [[ ! "${1:-}" =~ ^[0-9]+$ ]] || ((10#${1:-0} < 1 || 10#${1:-0} > 200)); then
          json_fail "invalid_limit" "catalog result limit must be between 1 and 200" "use --limit 1..200 or --all"
          return 1
        fi
        result_limit="$1"
        ;;
      --*)
        json_fail "invalid_option" "unknown catalog option: $1" "use lr catalog [pack] [--limit N|--all]"
        return 1
        ;;
      *)
        if [[ -n "$pack_id" ]]; then
          json_fail "invalid_arguments" "catalog accepts at most one Pack ID" "use lr catalog [pack] [--limit N|--all]"
          return 1
        fi
        pack_id="$1"
        ;;
    esac
    shift
  done
  local request_url="$base_url/agent/operations"
  if [[ -n "$pack_id" ]]; then
    validate_pack_id "$pack_id"
    request_url+="?pack=$pack_id"
  fi
  authenticated_request GET "$request_url" | jq --argjson limit "$result_limit" '
    .operations as $all
    | (if $limit == 0 then $all else $all[:$limit] end) as $returned
    | .operations = $returned
    | .count = ($all | length)
    | .returned = ($returned | length)
    | .truncated = (($returned | length) < ($all | length))
    | .next_action = (if .truncated then "narrow with lr catalog <pack>, increase --limit, or use --all" else "choose an operation_key, then use lr describe and lr preflight" end)
  '
}

command_compare() {
  (($# >= 2 && $# <= 50)) || fail "compare requires between 2 and 50 operation keys"
  local operation_key pack_id operation_id
  declare -A seen_operation_keys=()
  for operation_key in "$@"; do
    [[ "$operation_key" == *.* ]] || fail "invalid operation key: $operation_key"
    pack_id="${operation_key%%.*}"
    operation_id="${operation_key#*.}"
    validate_pack_id "$pack_id"
    validate_operation_id "$operation_id"
    [[ -z "${seen_operation_keys[$operation_key]+x}" ]] || fail "duplicate operation key: $operation_key"
    seen_operation_keys[$operation_key]=1
  done
  local request
  request="$(jq -cn --args '$ARGS.positional | {operation_keys:.}' "$@")"
  authenticated_request POST "$base_url/agent/compare" "$request" | jq .
}

command_describe() {
  local pack_id="${1:-}"
  local operation_id="${2:-}"
  [[ -n "$pack_id" && -n "$operation_id" ]] || fail "describe requires a Pack ID and operation ID"
  validate_pack_id "$pack_id"
  operation_id="$(normalize_operation_selector "$pack_id" "$operation_id")"
  validate_operation_id "$operation_id"
  authenticated_request GET "$base_url/agent/operations/$pack_id/$operation_id" | jq 'if (.data | type) == "object" then .data else . end'
}

command_preflight() {
  local pack_id="${1:-}"
  local operation_id="${2:-}"
  local input_argument="${3-}"
  local path_parameters_argument="${4-}"
  local query_parameters_argument="${5-}"
  [[ -n "$pack_id" && -n "$operation_id" ]] || fail "preflight requires a Pack ID and operation ID"
  validate_pack_id "$pack_id"
  operation_id="$(normalize_operation_selector "$pack_id" "$operation_id")"
  validate_operation_id "$operation_id"
  [[ -n "$input_argument" ]] || input_argument='{}'
  [[ -n "$path_parameters_argument" ]] || path_parameters_argument='{}'
  [[ -n "$query_parameters_argument" ]] || query_parameters_argument='{}'
  local input path_parameters query_parameters request
  input="$(json_argument "$input_argument")"
  path_parameters="$(json_argument "$path_parameters_argument")"
  query_parameters="$(json_argument "$query_parameters_argument")"
  [[ "$(jq -r 'type' <<<"$path_parameters")" = "object" ]] || fail "path parameters must be a JSON object"
  [[ "$(jq -r 'type' <<<"$query_parameters")" = "object" ]] || fail "query parameters must be a JSON object"
  request="$(jq -cn --arg pack "$pack_id" --arg operation "$operation_id" --argjson input "$input" --argjson path_parameters "$path_parameters" --argjson query_parameters "$query_parameters" '{pack:$pack,operation:$operation,input:$input,path_parameters:$path_parameters,query_parameters:$query_parameters}')"
  local response
  response="$(authenticated_request POST "$base_url/agent/preflight" "$request")"
  jq . <<<"$response"
  [[ "$(jq -r '.ok // false' <<<"$response")" = "true" ]] || return 1
}

command_init() {
  local contract identity
  contract="$(discovery)"
  if [[ ! -f "$api_token_file" ]]; then
    jq -n --arg file "$api_token_file" --arg console "$base_url/#tokens" '{ready:false,code:"agent_identity_required",token_file:$file,registration_url:$console,next_action:"Use lr identity request <agent-code> <policy-json> to request exact service scope, then have the human approve it in Agent Workbench. lr identity claim saves and binds the approved credential privately. Existing issued mode-600 Token files can still be bound; never read an administrator credential.",can_continue:["lr guide","lr tree","lr docs <pack>"]}'
    return 1
  fi
  identity="$(authenticated_request GET "$base_url/agent/whoami")" || { printf '%s\n' "$identity"; return 1; }
  if [[ -n "${agent_binding:-}" ]] && ! jq -e --argjson binding "$agent_binding" '.agent_code == $binding.agent_code and .workspace == $binding.workspace' >/dev/null <<<"$identity"; then
    json_fail "agent_identity_mismatch" "the bound Token no longer matches this Agent session" "bind the correct issued identity with lr identity bind; no fallback identity was selected"
    return 1
  fi
  jq --arg file "$api_token_file" --arg console "$base_url/#tokens" '. + {token_file:$file,registration_url:$console,ready:(.identity_ready // false),next_action:(if .identity_ready then "Identity is ready. Bind the issued locator once with lr identity bind <agent-code> <token-file>; use lr exec for an authorized operation with automatic model checking and preflight." else "This is a shared/bootstrap identity. Use lr identity request <agent-code> <policy-json> to request exact service scope; the human approves it once in Agent Workbench, then lr identity claim saves it privately. Existing issued files can use lr identity bind. Do not issue Tokens through /local/api." end)}' <<<"$identity"
  [[ "$(jq -r '.identity_ready // false' <<<"$identity")" == true ]]
}

command_guide() {
  curl --noproxy '*' --fail-with-body --silent --show-error "$base_url/docs/agent-start.md"
}

command_whoami() {
  authenticated_request GET "$base_url/agent/whoami" | jq .
}

command_setup() {
  local action="${1:-help}"
  shift || true
  local arguments='{}' tool_name
  case "$action" in
    schema) curl --noproxy '*' --fail-with-body --silent "$base_url/docs/agent.json" | jq '.service_workspace.prepare_schema' ; return ;;
    templates)
      case "${1:-}" in "") ;; --all) arguments='{"full":true}' ;; *) fail "use lr setup templates [--all] or lr setup template <id> <version>" ;; esac
      tool_name=localrouter_setup_templates ;;
    template)
      [[ -n "${1:-}" && -n "${2:-}" ]] || fail "select an exact template id and version"
      arguments="$(jq -cn --arg id "$1" --arg version "$2" '{id:$id,version:$version}')"; tool_name=localrouter_setup_templates ;;
    list|bundles) tool_name="localrouter_setup_$action" ;;
    prepare) [[ -n "${1:-}" ]] || fail "setup prepare requires JSON or @file"; arguments="$(json_argument "$1")"; tool_name=localrouter_setup_prepare ;;
    get|verify|reconcile)
      [[ -n "${1:-}" ]] || fail "setup $action requires a proposal id"
      arguments="$(jq -cn --arg id "$1" '{id:$id}')"; tool_name="localrouter_setup_$action" ;;
    withdraw|apply)
      [[ -n "${1:-}" && -n "${2:-}" ]] || fail "setup $action requires proposal id and exact digest"
      arguments="$(jq -cn --arg id "$1" --arg digest "$2" '{id:$id,digest:$digest}')"; tool_name="localrouter_setup_$action" ;;
    traces) arguments="$(jq -cn --arg trace_id "${1:-}" '{trace_id:$trace_id}')"; tool_name=localrouter_setup_traces ;;
    help|-h|--help) usage; return ;;
    *) fail "unknown setup action: $action" ;;
  esac
  if [[ "$action" == apply ]]; then
    [[ -n "$maintainer_token_file" ]] || fail "setup apply requires an explicitly delegated maintenance-only Token locator"
    command_manage_call "$tool_name" "$arguments"
  elif [[ "${LOCALROUTER_SETUP_LANE:-service}" == maintenance ]]; then
    [[ -n "$maintainer_token_file" ]] || fail "maintenance setup requires a delegated maintenance Token locator"
    command_manage_call "$tool_name" "$arguments"
  else
    local response
    response="$(command_mcp_call "$tool_name" "$arguments")" || return $?
    jq '.structuredContent // .' <<<"$response"
  fi
}

command_show() {
  local pack_id="${1:-}"
  [[ -n "$pack_id" ]] || fail "show requires a Pack ID"
  local result
  result="$(discovery | jq --arg id "$pack_id" '
    ([.compatibility_packs[]? | select(.id == $id)]
      + [.protocols[] | select(.id == $id) | {id, pack_key, kind, name, description, ready, status, status_label, mount, openai_v1_base_url, workflow_mount, pool, docs, guides, routes: [.routes[] | {operation_key, operation_id, operation_id_role, operation_id_is_url, methods, path, call_url, call, request_example_role, dynamic_inputs, summary, streaming, transport}]}])
  ')"
  if [[ "$(jq 'length' <<<"$result")" = "0" ]]; then
    json_fail "pack_not_found" "unknown Pack: $pack_id" "run lr tree or lr find <intent>, then use a published Pack ID"
    return 1
  fi
  [[ "$(jq 'length' <<<"$result")" = "1" ]] || fail "Pack ID is ambiguous across compatibility and Protocol Packs: $pack_id"
  jq '.[0]' <<<"$result"
}

command_docs() {
  local pack_id="${1:-}"
  [[ -n "$pack_id" ]] || fail "docs requires a Pack ID"
  local markdown_path
  markdown_path="$(discovery | jq -r --arg id "$pack_id" '.protocols[] | select(.id == $id) | .docs.markdown // empty')"
  [[ -n "$markdown_path" ]] || fail "unknown Pack or missing Markdown guide: $pack_id"
  validate_local_path "$markdown_path"
  curl --noproxy '*' --fail-with-body --silent --show-error "$base_url$markdown_path"
}

command_runtime_openai() {
  local pack_id="${1:-}"
  local model_id="${2:-}"
  [[ -n "$pack_id" && -n "$model_id" ]] || fail "runtime-openai requires a Pack ID and exact model ID"
  validate_pack_id "$pack_id"

  local contract binding model_search exact_model
  contract="$(discovery)"
  binding="$(jq -c --arg pack "$pack_id" '
    [.protocols[] | select(.id == $pack) | {
      ready, status, mount, openai_v1_base_url,
      models: ([.routes[] | select(.path == "/models" and (.methods | index("GET")))] | length),
      chat: ([.routes[] | select(.path == "/chat/completions" and (.methods | index("POST")))] | length)
    }] | if length == 1 then .[0] else empty end
  ' <<<"$contract")"
  [[ -n "$binding" ]] || fail "unknown Pack: $pack_id"
  [[ "$(jq -r '.ready and (.models == 1) and (.chat == 1)' <<<"$binding")" = "true" ]] || fail "Pack is not a ready OpenAI-compatible runtime mount with GET /models and POST /chat/completions"

  model_search="$(command_find_model "$pack_id:$model_id" 20 true)"
  exact_model="$(jq -c --arg pack "$pack_id" --arg model "$model_id" '
    [.matches[] | select(.pack == $pack and .id == $model)] | if length == 1 then .[0] else empty end
  ' <<<"$model_search")"
  [[ -n "$exact_model" ]] || fail "model is not currently advertised by $pack_id: $model_id"

  local runtime_base_url
  runtime_base_url="$(jq -r '.openai_v1_base_url // empty' <<<"$binding")"
  [[ -n "$runtime_base_url" ]] || fail "running LocalRouter does not publish an OpenAI v1 Base URL for this Pack; install and restart a runtime with contract schema 7 or newer"

  jq -n \
    --arg pack "$pack_id" \
    --arg model "$model_id" \
    --arg base_url "$base_url$runtime_base_url" \
    --arg api_token_file "$api_token_file" \
    --arg operation_key "$(jq -r '.compatible_operations[0].operation_key' <<<"$exact_model")" \
    '{
      object: "localrouter.runtime.openai",
      pack: $pack,
      adapter: "openai-completions",
      base_url: $base_url,
      model: $model,
      operation_key: $operation_key,
      api_token_file: $api_token_file,
      route_contract: "use this published Base URL unchanged; the runtime appends /models and /chat/completions",
      credential_value_exported: false
    }'
}

command_call() {
  local pack_id="${1:-}"
  local operation_id="${2:-}"
  (($# <= 5)) || fail "call accepts pack, operation, body, path parameters and query parameters"
  local body_input="${3-}"
  local path_input="${4-}" query_input="${5-}"
  [[ -n "$body_input" ]] || body_input='{}'
  [[ -n "$pack_id" && -n "$operation_id" ]] || fail "call requires a Pack ID and operation ID"
  validate_pack_id "$pack_id"
  operation_id="$(normalize_operation_selector "$pack_id" "$operation_id")"
  validate_operation_id "$operation_id"
  local binding
  binding="$(discovery | jq -c --arg pack "$pack_id" --arg operation "$operation_id" '
    [.protocols[] | select(.id == $pack) as $protocol
      | $protocol.routes[] | select(.operation_id == $operation)
      | {ready: $protocol.ready, status: $protocol.status, path: .call_url, method: .call.default_method, required_query: (.query_parameters // [])}]
  ')"
  if [[ "$(jq 'length' <<<"$binding")" != "1" ]]; then
    json_fail "operation_not_found" "operation not found or ambiguous: $pack_id/$operation_id" "run lr show $pack_id or lr find operation <intent>, then use the published operation_id"
    return 1
  fi
  local request_path method body
  request_path="$(jq -r '.[0].path' <<<"$binding")"
  method="$(jq -r '.[0].method' <<<"$binding")"
  local path_parameters query_parameters
  path_parameters="$(json_argument "$path_input")"
  query_parameters="$(json_argument "$query_input")"
  request_path="$(jq -ner --arg path "$request_path" --argjson params "$path_parameters" --argjson query "$query_parameters" --argjson required "$(jq '.[0].required_query' <<<"$binding")" '
    if ($params|type)!="object" or ($query|type)!="object" then error("path and query parameters must be JSON objects") else . end
    | ($path | [scan("\\{([^{}]+)\\}") | .[0]]) as $names
    | if (($params|keys) - $names | length)>0 then error("unknown path parameter") else . end
    | reduce $names[] as $name ($path;
        if ($params[$name]|type)!="string" or $params[$name]=="" or $params[$name]=="." or $params[$name]==".." or ($params[$name]|contains("/") or contains("\\") or (explode|any(. < 32))) then error("missing or invalid path parameter: " + $name)
        else split("{"+$name+"}") | join($params[$name]|@uri) end)
    | . as $rendered
    | if any($required[]; . as $key | ($query|has($key)|not)) then error("missing required query parameter") else . end
    | ($query | to_entries | map(if (.value|type)=="string" or (.value|type)=="number" or (.value|type)=="boolean" then (.key|@uri)+"="+(.value|tostring|@uri) else error("query values must be strings, numbers or booleans") end) | join("&")) as $encoded
    | $rendered + (if $encoded=="" then "" elif ($rendered|contains("?")) then "&"+$encoded else "?"+$encoded end)
  ')" || return 1
  body="$(json_argument "$body_input")"
  if [[ "$method" = "GET" && "$body" != "{}" ]]; then
    json_fail "query_parameters_required" "GET operation bodies are not supported" "pass an empty body {}, then path parameters {}, then query parameters as the fifth argument"
    return 1
  fi
  authenticated_request "$method" "$base_url$request_path" "$body"
}

# An authorized operation has one preparation path. Reuse one current contract
# within this execution, resolve its dynamic model once, and never replay the
# final request (including when a later parser or streaming consumer fails).
command_exec() {
  (($# >= 2 && $# <= 5)) || fail "exec accepts pack, operation, body, path parameters and query parameters"
  local pack_id="$1" operation_id="$2" body path_parameters query_parameters
  validate_pack_id "$pack_id"
  operation_id="$(normalize_operation_selector "$pack_id" "$operation_id")"
  validate_operation_id "$operation_id"
  body="$(json_argument "${3-}")"
  path_parameters="$(json_argument "${4-}")"
  query_parameters="$(json_argument "${5-}")"
  lr_contract_cache="$(discovery)" || return 1
  local identity descriptor prepared field value model_result
  local pending_binding
  pending_binding="$(agent_binding_path)" || pending_binding=""
  if [[ -z "${LOCALROUTER_API_TOKEN_FILE:-}" && -z "${agent_binding:-}" && -n "$pending_binding" && -f "${pending_binding%.json}.enrollment/request.json" ]]; then
    # An approved pending handshake is completed by the normal call entry.
    # Pending/denied requests return to the user without dispatching a call.
    identity="$(command_identity claim)" || { printf '%s\n' "$identity"; return 1; }
    load_agent_binding
  fi
  identity="$(command_init)" || { printf '%s\n' "$identity"; return 1; }
  jq -e --arg workspace "$PWD" '.workspace == $workspace and .service_access == true and .maintenance_access == false' >/dev/null <<<"$identity" || {
    json_fail "agent_identity_mismatch" "the issued service identity does not belong to this workspace" "bind the correct identity once with lr identity bind <agent-code> <token-file>"
    return 1
  }
  descriptor="$(command_describe "$pack_id" "$operation_id")" || { printf '%s\n' "$descriptor"; return 1; }
  jq -e --argjson contract "$lr_contract_cache" '.contract_digest == $contract.contract.digest and .contract_schema_version == $contract.contract.schema_version' >/dev/null <<<"$descriptor" || {
    json_fail "contract_changed" "the service contract changed during preparation; no operation was sent" "start a fresh lr exec to prepare against the current contract"
    return 1
  }
  while IFS= read -r field; do
    [[ -n "$field" ]] || continue
    value="$(jq -r --arg field "$field" --argjson path "$path_parameters" '.[$field] // $path[$field] // empty' <<<"$body")"
    [[ -n "$value" ]] || { json_fail "dynamic_input_required" "missing dynamic input: $field" "provide an exact published value in the request"; return 1; }
    model_result="$(command_find_model "$pack_id:$value" 20 true)" || { printf '%s\n' "$model_result"; return 1; }
    jq -e --arg pack "$pack_id" --arg model "$value" --arg operation "$pack_id.$operation_id" '.count == 1 and .complete == true and .matches[0].pack == $pack and .matches[0].id == $model and any(.matches[0].compatible_operations[]; .operation_key == $operation)' >/dev/null <<<"$model_result" || {
      json_fail "exact_model_unavailable" "no unique exact model compatible with $pack_id.$operation_id: $value" "choose an exact model_key and compatible operation from the current model catalogue; no generation was sent"
      return 1
    }
  done < <(jq -r '.dynamic_inputs // {} | keys[]' <<<"$descriptor")
  prepared="$(command_preflight "$pack_id" "$operation_id" "$body" "$path_parameters" "$query_parameters")" || { printf '%s\n' "$prepared"; return 1; }
  jq -e --argjson descriptor "$descriptor" '.contract_digest == $descriptor.contract_digest and .schema_version == $descriptor.contract_schema_version' >/dev/null <<<"$prepared" || {
    json_fail "contract_changed" "the service contract changed before dispatch; no operation was sent" "start a fresh lr exec to prepare against the current contract"
    return 1
  }
  recorded_call "$pack_id" "$operation_id" "$body" "$path_parameters" "$query_parameters"
}

execution_directory() {
  local binding
  binding="$(agent_binding_path)" || {
    local identity_key
    identity_key="$(printf '%s\0%s\0%s' "$base_url" "$PWD" "$api_token_file" | sha256sum)"
    binding="$xdg_data_home/localrouter/agent-bindings/${identity_key%% *}.json"
  }
  printf '%s.results' "${binding%.json}"
}

# Save the raw response before downstream parsing. The gateway owns bounded
# safe retries; the CLI dispatches once and keeps unknown outcomes inspectable.
recorded_call() {
  local result_root result_dir temporary call_status output_status outcome
  result_root="$(execution_directory)"
  mkdir -p -m 700 "$result_root"
  [[ ! -L "$result_root" && "$(stat -c '%u:%a' "$result_root")" = "$EUID:700" ]] || fail "execution directory must be private and owned by the current user"
  result_dir="$(mktemp -d "$result_root/call-XXXXXXXXXXXX")"
  chmod 700 "$result_dir"
  temporary="$(mktemp "$result_dir/.receipt.XXXXXX")"
  local LOCALROUTER_TRACE_ID="${LOCALROUTER_TRACE_ID:-}"
  if [[ -z "$LOCALROUTER_TRACE_ID" ]]; then LOCALROUTER_TRACE_ID="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"; fi
  jq -n --arg id "${result_dir##*/}" --arg pack "$1" --arg operation "$2" --arg trace "$LOCALROUTER_TRACE_ID" --arg origin "$base_url" --arg response "$result_dir/response" --arg stderr "$result_dir/stderr" '{id:$id,pack:$pack,operation:$operation,trace_id:$trace,origin:$origin,state:"dispatching",outcome:"unknown",response_file:$response,stderr_file:$stderr,started_at:(now|floor),next_action:"If interrupted, inspect the saved response and lr setup traces for this trace_id; do not replay an unknown operation."}' >"$temporary"
  mv -- "$temporary" "$result_dir/receipt.json"
  (umask 077; : >"$result_dir/response"; : >"$result_dir/stderr")
  local -a pipeline_status
  set +e
  (set -e; command_call "$@") 2>"$result_dir/stderr" | tee -p "$result_dir/response"
  pipeline_status=("${PIPESTATUS[@]}")
  set -e
  call_status="${pipeline_status[0]}"; output_status="${pipeline_status[1]}"
  outcome=unknown
  if [[ "$call_status" == 0 && "$output_status" == 0 ]]; then outcome=response_received; fi
  temporary="$(mktemp "$result_dir/.receipt.XXXXXX")"
  jq --arg outcome "$outcome" --argjson exit_code "$call_status" --argjson output_exit_code "$output_status" '. + {state:"finished",outcome:$outcome,exit_code:$exit_code,output_exit_code:$output_exit_code,finished_at:(now|floor)}' "$result_dir/receipt.json" >"$temporary"
  mv -f -- "$temporary" "$result_dir/receipt.json"
  cat "$result_dir/stderr" >&2
  if [[ "$call_status" != 0 || "$output_status" != 0 ]]; then printf 'lr: response retained; inspect lr result %s before another call\n' "${result_dir##*/}" >&2; return 1; fi
}

command_result() {
  local root id="${1:-}" receipt
  root="$(execution_directory)"
  [[ -d "$root" && ! -L "$root" && "$(stat -c '%u:%a' "$root")" = "$EUID:700" ]] || fail "no private execution receipts for this Agent session"
  if [[ -z "$id" ]]; then
    local -a receipts=("$root"/call-*/receipt.json)
    [[ -e "${receipts[0]}" ]] || { printf '{"results":[]}\n'; return; }
    for receipt in "${receipts[@]}"; do [[ -f "$receipt" && ! -L "$receipt" && "$(stat -c '%u:%a' "$receipt")" = "$EUID:600" ]] || fail "invalid execution receipt"; done
    jq -s '{results:(sort_by(.started_at)|reverse)}' "${receipts[@]}"
    return
  fi
  [[ "$id" =~ ^call-[A-Za-z0-9]{12}$ ]] || fail "use lr result [call-id]"
  receipt="$root/$id/receipt.json"
  [[ -f "$receipt" && ! -L "$receipt" && "$(stat -c '%u:%a' "$receipt")" = "$EUID:600" ]] || fail "execution receipt not found or not private"
  if [[ "${2:-}" == --refresh ]]; then
    local trace origin traces
    trace="$(jq -r '.trace_id' "$receipt")"; origin="$(jq -r '.origin' "$receipt")"
    [[ "$trace" =~ ^[a-f0-9]{32}$ && "$origin" == "$base_url" ]] || fail "receipt origin or trace is invalid"
    traces="$(authenticated_request GET "$base_url/agent/traces?trace_id=$trace")" || { printf '%s\n' "$traces"; return 1; }
    jq --argjson traces "$traces" '. + {gateway_evidence:$traces.data,provider_replayed:false,next_action:"Read response_file and gateway evidence; only a declared status operation or authoritative provider receipt can resolve an unknown resource outcome."}' "$receipt"
    return
  fi
  [[ $# == 1 ]] || fail "use lr result [call-id [--refresh]]"
  jq . "$receipt"
}

command_run() {
  local pack_id="${1:-}"
  local target_id="${2:-}"
  local body_input="${3-}"
  [[ -n "$body_input" ]] || body_input='{}'
  [[ -n "$pack_id" && -n "$target_id" ]] || fail "run requires a Pack ID and operation or workflow ID"
  validate_pack_id "$pack_id"
  validate_operation_id "$target_id"
  local is_workflow body
  is_workflow="$(discovery | jq -r --arg pack "$pack_id" --arg workflow "$target_id" 'any(.protocols[] | select(.id == $pack) | .workflows[]?; .id == $workflow)')"
  if [[ "$is_workflow" = "true" ]]; then
    body="$(json_argument "$body_input")"
    authenticated_request POST "$base_url/w/$pack_id/$target_id" "$body"
    return
  fi
  target_id="$(normalize_operation_selector "$pack_id" "$target_id")"
  command_call "$pack_id" "$target_id" "$body_input"
}

command_watch() {
  local pack_id="${1:-}"
  local workflow_id="${2:-}"
  local job_id="${3:-}"
  local timeout_seconds="${4:-0}"
  [[ -n "$pack_id" && -n "$workflow_id" && -n "$job_id" ]] || fail "watch requires a Pack ID, workflow ID and job ID"
  validate_pack_id "$pack_id"
  validate_operation_id "$workflow_id"
  [[ "$job_id" =~ ^job-[a-zA-Z0-9_-]{8,128}$ ]] || fail "invalid workflow job ID"
  [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || fail "watch timeout must be zero or a positive number of seconds"
  local poll_interval="${LOCALROUTER_WATCH_INTERVAL_SECONDS:-2}"
  [[ "$poll_interval" =~ ^[0-9]+$ ]] && ((poll_interval >= 1 && poll_interval <= 3600)) || fail "LOCALROUTER_WATCH_INTERVAL_SECONDS must be between 1 and 3600"
  local watch_started_epoch response state
  watch_started_epoch="$(date +%s)"
  while true; do
    response="$(authenticated_request GET "$base_url/w/$pack_id/$workflow_id/$job_id")"
    state="$(jq -r '.data.state // empty' <<<"$response")"
    [[ -n "$state" ]] || fail "workflow response did not contain data.state"
    if [[ "${LOCALROUTER_WATCH_PROGRESS:-0}" = "1" ]]; then
      jq -r '"lr: workflow state=" + .data.state + " attempts=" + ((.data.attempts // 0)|tostring)' <<<"$response" >&2
    fi
    case "$state" in
      succeeded)
        jq . <<<"$response"
        return 0
        ;;
      failed|cancelled|timed_out)
        jq . <<<"$response"
        return 1
        ;;
    esac
    if ((timeout_seconds > 0 && $(date +%s) - watch_started_epoch >= timeout_seconds)); then
      jq -n --arg code "watch_timeout" --arg state "$state" --arg pack "$pack_id" --arg workflow "$workflow_id" --arg job "$job_id" '{success:false,code:$code,retryable:true,state:$state,pack:$pack,workflow:$workflow,job:$job,next_action:"resume lr watch with the same job ID"}' >&2
      return 1
    fi
    sleep "$poll_interval"
  done
}

command_cancel() {
  local pack_id="${1:-}"
  local workflow_id="${2:-}"
  local job_id="${3:-}"
  [[ -n "$pack_id" && -n "$workflow_id" && -n "$job_id" ]] || fail "cancel requires a Pack ID, workflow ID and job ID"
  validate_pack_id "$pack_id"
  validate_operation_id "$workflow_id"
  [[ "$job_id" =~ ^job-[a-zA-Z0-9_-]{8,128}$ ]] || fail "invalid workflow job ID"
  authenticated_request DELETE "$base_url/w/$pack_id/$workflow_id/$job_id" | jq .
}

command_request() {
  local method="${1:-}"
  local request_path="${2:-}"
  local body_input="${3:-}"
  [[ -n "$method" && -n "$request_path" ]] || fail "request requires a method and path"
  method="${method^^}"
  validate_local_path "$request_path"
  local body=""
  if [[ -n "$body_input" ]]; then
    body="$(json_argument "$body_input")"
  fi
  authenticated_request "$method" "$base_url$request_path" "$body"
}

command_mcp_list() {
  local search_text="${1:-}"
  local response
  response="$(authenticated_request POST "$mcp_url" '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}')"
  local matches
  matches="$(jq -r --arg query "${search_text,,}" '
    if .error then error(.error.message) else .result.tools[] end
    | select($query == "" or ((.name + " " + .description) | ascii_downcase | contains($query)))
    | [.name, .description, (.annotations.readOnlyHint // false), (.annotations.destructiveHint // false)]
    | @tsv
  ' <<<"$response")"
  [[ -n "$matches" ]] || fail "no ready MCP tool matched: $search_text"
  printf 'name\tdescription\tread_only\tdestructive\n%s\n' "$matches"
}

command_mcp_call() {
  local tool_name="${1:-}"
  local arguments_input="${2-}"
  [[ -n "$arguments_input" ]] || arguments_input='{}'
  [[ -n "$tool_name" ]] || fail "mcp-call requires a tool name"
  local arguments request
  arguments="$(json_argument "$arguments_input")"
  request="$(jq -cn --arg name "$tool_name" --argjson arguments "$arguments" '{jsonrpc:"2.0",id:1,method:"tools/call",params:{name:$name,arguments:$arguments}}')"
  local response
  response="$(authenticated_request POST "$mcp_url" "$request")"
  if jq -e '.error != null' >/dev/null <<<"$response"; then
    jq -r '"lr: MCP error " + (.error.code | tostring) + ": " + .error.message' <<<"$response" >&2
    return 1
  fi
  if jq -e '.result.isError == true' >/dev/null <<<"$response"; then
    jq '.result.structuredContent // .result' <<<"$response" >&2
    return 1
  fi
  jq '.result' <<<"$response"
}

command_manage_list() {
  local search_text="${1:-}"
  local response
  response="$(maintenance_request POST "$maintenance_mcp_url" '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}')"
  local matches
  matches="$(jq -r --arg query "${search_text,,}" '
    if .error then error(.error.message) else .result.tools[] end
    | select($query == "" or ((.name + " " + .description) | ascii_downcase | contains($query)))
    | [.name, .description, (.annotations.readOnlyHint // false), (.annotations.destructiveHint // false)]
    | @tsv
  ' <<<"$response")"
  [[ -n "$matches" ]] || fail "no maintenance tool matched: $search_text"
  printf '%s\n' "$matches"
}

command_manage_status() {
  local contract
  contract="$(discovery)"
  jq -n \
    --arg lane "$(if [[ -n "$maintainer_token_file" ]]; then printf 'agent-token'; else printf 'human-operator'; fi)" \
    --argjson contract "$contract" '
      {
        object: "localrouter.maintenance.status",
        selected_lane: $lane,
        agent_maintenance_enabled: ($contract.maintenance.auth.agent_token.enabled // false),
        prerequisite: (if $lane == "agent-token"
          then "discovery must enable maintenance.auth.agent_token and the supplied locator must contain a distinct localrouter.maintain Token"
          else "human operator only; Agents must request an enabled distinct maintenance-only Token and must not read administrator credentials"
          end),
        credential_value_exported: false,
        next: "use lr manage-list, then open an isolated draft and apply only its reviewed exact digest"
      }'
}

command_manage_call() {
  local tool_name="${1:-}"
  local arguments_input="${2-}"
  [[ -n "$arguments_input" ]] || arguments_input='{}'
  [[ -n "$tool_name" ]] || fail "manage-call requires a tool name"
  local arguments request response
  arguments="$(json_argument "$arguments_input")"
  request="$(jq -cn --arg name "$tool_name" --argjson arguments "$arguments" '{jsonrpc:"2.0",id:1,method:"tools/call",params:{name:$name,arguments:$arguments}}')"
  response="$(maintenance_request POST "$maintenance_mcp_url" "$request")"
  if jq -e '.error != null' >/dev/null <<<"$response"; then
    jq -r '"lr: maintenance MCP error " + (.error.code | tostring) + ": " + .error.message' <<<"$response" >&2
    return 1
  fi
  if jq -e '.result.isError == true' >/dev/null <<<"$response"; then
    jq '.result.structuredContent' <<<"$response" >&2
    return 1
  fi
  jq '.result.structuredContent // .result' <<<"$response"
}

command_env() {
  jq -n \
    --arg base_url "$base_url" \
    --arg discovery_url "$discovery_url" \
    --arg mcp_url "$mcp_url" \
    --arg maintenance_mcp_url "$maintenance_mcp_url" \
    --arg api_token_file "$api_token_file" \
    --arg admin_token_file "$admin_token_file" \
    --arg maintainer_token_file "$maintainer_token_file" \
    '{base_url:$base_url, discovery_url:$discovery_url, mcp_url:$mcp_url, maintenance_mcp_url:$maintenance_mcp_url, api_token_file:$api_token_file, maintenance_auth:(if $maintainer_token_file == "" then "administrator" else "agent-token" end), admin_token_file:$admin_token_file, maintainer_token_file:(if $maintainer_token_file == "" then null else $maintainer_token_file end), token_value_exported:false}'
}

