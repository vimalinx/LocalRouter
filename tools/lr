case "$command_name" in
  identity|help|guide|status|tree|show|docs) ;;
  *) load_agent_binding ;;
esac
if [[ "$command_name" != "help" && ("${1:-}" == "-h" || "${1:-}" == "--help") ]]; then
  usage
  exit 0
fi
case "$command_name" in
  init) command_init "$@" ;;
  identity) command_identity "$@" ;;
  guide) command_guide "$@" ;;
  status) command_status "$@" ;;
