#!/usr/bin/env bash
set -euo pipefail

base_url="${LOCALROUTER_BASE_URL:-http://127.0.0.1:8317}"
base_url="${base_url%/}"
discovery_url="${LOCALROUTER_DISCOVERY_URL:-$base_url/.well-known/localrouter.json}"
mcp_url="${LOCALROUTER_MCP_URL:-$base_url/mcp}"
maintenance_mcp_url="${LOCALROUTER_MAINTENANCE_MCP_URL:-$base_url/manage/mcp}"
xdg_data_home="${XDG_DATA_HOME:-${HOME:?HOME is required}/.local/share}"
[[ "$xdg_data_home" = /* ]] || xdg_data_home="$HOME/.local/share"
default_api_token_file="$xdg_data_home/localrouter/api-token"
default_admin_token_file="$xdg_data_home/localrouter/admin-token"
api_token_file="${LOCALROUTER_API_TOKEN_FILE:-$default_api_token_file}"
admin_token_file="${LOCALROUTER_ADMIN_TOKEN_FILE:-$default_admin_token_file}"
maintainer_token_file="${LOCALROUTER_MAINTAINER_TOKEN_FILE:-}"

# Recover only the retired repository-local locators used before the XDG install.
# Other explicit locator failures remain authoritative instead of silently falling back.
legacy_project_root="${LOCALROUTER_PROJECT_ROOT:-}"
legacy_project_root="${legacy_project_root%/}"
if [[ -n "$legacy_project_root" ]]; then
  if [[ "$api_token_file" == "$legacy_project_root/gateway/data/api-token" && ! -e "$api_token_file" && -f "$default_api_token_file" ]]; then
    api_token_file="$default_api_token_file"
  fi
  if [[ "$admin_token_file" == "$legacy_project_root/gateway/data/admin-token" && ! -e "$admin_token_file" && -f "$default_admin_token_file" ]]; then
    admin_token_file="$default_admin_token_file"
  fi
fi

usage() {
  cat <<'EOF'
Usage: lr <command> [arguments]

Discover
  lr status                         Health and compatibility/Protocol Pack readiness
  lr tree [pack]                    Show all LR surfaces and Packs as one tree
  lr find <text>                    Search operations, live models and pool metadata
  lr find operation <text>          Search only callable operation contracts
  lr find model [--exact] [--limit N|--all] [text]
                                    Query live model IDs; return at most 20 by default
  lr find pool [text]               Search pool, quota and pricing metadata
  lr models [options] [text]        Precise alias for `lr find model`
  lr pools [text]                   Precise alias for `lr find pool`
  lr catalog [pack] [--limit N|--all]
                                    List operations; return at most 20 by default
  lr resolve <capability> [limit]   Return all exact independent matches as JSON
  lr compare <pack.operation> <pack.operation> [...]
                                    Compare exact operations without merging or choosing one
  lr show <pack>                    Show one compatibility or Protocol Pack
  lr describe <pack> <operation>    Read one compact operation contract; operation_key is accepted
  lr docs <pack>                    Read the Pack's generated Markdown guide
  lr runtime-openai <pack> <model>  Emit the verified OpenAI-compatible base URL and exact model
  lr env                            Show non-secret LocalRouter configuration

Call
  lr preflight <pack> <operation> [json] [path-params-json] [query-params-json]
                                    Validate auth, readiness and input without an upstream call
  lr call <pack> <operation> [json] Call one exact Pack operation without path params
  lr run <pack> <operation|workflow> [json]
                                    Call an operation or start a persistent workflow
  lr watch <pack> <workflow> <job> [timeout-seconds]
                                    Wait for a terminal job; default timeout is unlimited
  lr cancel <pack> <workflow> <job> Cancel a persistent workflow job
  lr request <method> <path> [json] Call an explicit LocalRouter path
  lr mcp-list [text]                List ready MCP tools, optionally filtered
  lr mcp-call <tool> [json]         Call a ready MCP tool with arguments
  lr whoami                         Show this service Token's non-secret effective policy

Maintain (delegated operator or optional Agent maintenance Token)
  lr manage-status                  Show the selected maintenance lane and its prerequisites
  lr manage-list [text]             Inspect semantic maintenance tools; listing grants no authority
  lr manage-call <tool> [json]      Call one semantic draft tool in the selected maintenance lane

JSON may be an inline object or @/path/to/body.json. Service calls read the API
Token. With LOCALROUTER_MAINTAINER_TOKEN_FILE, an Agent must first confirm
maintenance.auth.agent_token.enabled=true in discovery and use a distinct
localrouter.maintain Token. Without that locator, manage commands use the
administrator-backed operator lane and require explicit user delegation for the
named change. Neither lane permits credential values in output. Do not replace
either lane by editing files, SQLite, live Packs, or restarting the service.

The browser console and /local/api use password-free loopback access by default.
An operator can enable password protection and choose a custom password in
Run Overview. This does not remove the separate administrator credential used
by the delegated /manage/mcp operator lane.

operation_id is a semantic selector for lr/Agent/MCP commands, not an HTTP URL.
Where a command already takes <pack>, <operation> may be either the bare
operation_id or the published pack-qualified operation_key.
For direct HTTP, use the exact call_url published by discovery or lr show.
EOF
}

fail() {
  printf 'lr: %s\n' "$*" >&2
  exit 1
}

json_fail() {
  local code="$1"
  local message="$2"
  local next_action="$3"
  jq -n --arg code "$code" --arg message "$message" --arg next_action "$next_action" '{
    success:false, code:$code, message:$message, reason:$message,
    retryable:false, owner:"agent", retry_after:null,
    next_action:$next_action, alternatives:[]
  }' >&2
  return 1
}

report_curl_failure() {
  local status="$1"
  if [[ "$status" != "22" ]]; then
    printf 'lr: LocalRouter transport failed (curl exit %s); run lr status and verify the loopback discovery URL\n' "$status" >&2
  fi
  return 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command is missing: $1"
}

validate_loopback_url() {
  local candidate_url="$1"
  case "$candidate_url" in
    http://127.0.0.1:*|http://\[::1\]:*) ;;
    *) fail "refusing non-loopback LocalRouter URL: $candidate_url" ;;
  esac
}

discovery() {
  curl --noproxy '*' --fail-with-body --silent --show-error "$discovery_url"
}

read_bearer_token() {
  local token_file="$1"
  [[ -f "$token_file" && ! -L "$token_file" ]] || fail "token file is not a regular file: $token_file"
  [[ "$(stat -c '%u' "$token_file")" = "$EUID" ]] || fail "token file is not owned by the current user"
  [[ "$(stat -c '%a' "$token_file")" = "600" ]] || fail "token file must have mode 0600"
  local token_line_count
  token_line_count="$(wc -l <"$token_file")"
  [[ "$token_line_count" = "1" ]] || fail "token file must contain exactly one line"
  IFS= read -r bearer_token <"$token_file"
  [[ -n "$bearer_token" ]] || fail "token file is empty"
}

curl_config_with_auth() {
  local escaped_token="$bearer_token"
  escaped_token="${escaped_token//\\/\\\\}"
  escaped_token="${escaped_token//\"/\\\"}"
  printf 'header = "Authorization: Bearer %s"\n' "$escaped_token"
  printf 'header = "Accept: application/json"\n'
}

curl_config_with_admin_auth() {
  local escaped_token="$bearer_token"
  escaped_token="${escaped_token//\\/\\\\}"
  escaped_token="${escaped_token//\"/\\\"}"
  printf 'header = "X-Local-Admin: %s"\n' "$escaped_token"
  printf 'header = "Accept: application/json"\n'
}

bearer_request() {
  local token_file="$1"
  local method="$2"
  local request_url="$3"
  local body="${4:-}"
  local curl_arguments=(--noproxy '*' --config /dev/fd/3 --fail-with-body --silent --request "$method")
  if [[ -n "$body" && "$method" != "GET" && "$method" != "HEAD" ]]; then
    curl_arguments+=(--header 'Content-Type: application/json' --data-binary @-)
  fi
  read_bearer_token "$token_file"
  if [[ -n "$body" && "$method" != "GET" && "$method" != "HEAD" ]]; then
    curl "${curl_arguments[@]}" "$request_url" 3< <(curl_config_with_auth) <<<"$body" || report_curl_failure "$?"
    return
  fi
  curl "${curl_arguments[@]}" "$request_url" 3< <(curl_config_with_auth) || report_curl_failure "$?"
}

authenticated_request() {
  bearer_request "$api_token_file" "$@"
}

maintenance_request() {
  if [[ -n "$maintainer_token_file" ]]; then
    bearer_request "$maintainer_token_file" "$@"
    return
  fi
  local method="$1"
  local request_url="$2"
  local body="${3:-}"
  local curl_arguments=(--noproxy '*' --config /dev/fd/3 --fail-with-body --silent --request "$method")
  if [[ -n "$body" && "$method" != "GET" && "$method" != "HEAD" ]]; then
    curl_arguments+=(--header 'Content-Type: application/json' --data-binary @-)
  fi
  read_bearer_token "$admin_token_file"
  if [[ -n "$body" && "$method" != "GET" && "$method" != "HEAD" ]]; then
    curl "${curl_arguments[@]}" "$request_url" 3< <(curl_config_with_admin_auth) <<<"$body" || report_curl_failure "$?"
    return
  fi
  curl "${curl_arguments[@]}" "$request_url" 3< <(curl_config_with_admin_auth) || report_curl_failure "$?"
}

validate_local_path() {
  local request_path="$1"
  [[ "$request_path" == /* && "$request_path" != //* && "$request_path" != *://* ]] || fail "path must be a LocalRouter-relative path beginning with one slash"
}

json_argument() {
  local input="${1-}"
  [[ -n "$input" ]] || input='{}'
  if [[ "$input" == @* ]]; then
    local json_file="${input#@}"
    [[ -f "$json_file" ]] || fail "JSON file not found: $json_file"
    jq -c . "$json_file"
  else
    jq -c . <<<"$input"
  fi
}

command_status() {
  local health_json discovery_json
  health_json="$(curl --noproxy '*' --fail-with-body --silent --show-error "$base_url/healthz")"
  discovery_json="$(discovery)"
  jq -n --argjson health "$health_json" --argjson contract "$discovery_json" '{
    health: $health,
    console: {
      url: "/",
      auth_enabled: ($contract.maintenance.console_auth.enabled // false),
      default_auth_enabled: ($contract.maintenance.console_auth.default_enabled // false)
    },
    compatibility_packs: [$contract.compatibility_packs[]? | {
      id, kind, status, ready, mounts,
      operations: (.routes | length),
      pool: {mode: .pool.mode, eligible: .pool.eligible}
    }],
    protocols: [$contract.protocols[] | {
      id, status, ready, mount,
      operations: (.routes | length),
      pool: (if .pool then {mode: .pool.mode, source: .pool.source, total: .pool.total, eligible: .pool.eligible} else null end)
    }]
  }'
}

command_tree() {
  local pack_id="${1:-}"
  if [[ -n "$pack_id" ]]; then
    validate_pack_id "$pack_id"
  fi
  local contract
  contract="$(discovery)"
  jq -r --arg filter "$pack_id" --arg root "$base_url" '
    [(.compatibility_packs // [])[] | select($filter == "" or .id == $filter) | . + {_node_kind:"compatibility"}] as $compatibility
    | [(.protocols // [])[] | select($filter == "" or .id == $filter) | . + {_node_kind:"protocol"}] as $protocols
    | (if $filter == "" then [(.surfaces // [])[] | . + {_node_kind:"surface"}] else [] end) as $surfaces
    | ($surfaces + $compatibility + $protocols) as $nodes
    | if ($compatibility | length) + ($protocols | length) == 0 and $filter != "" then error("unknown Pack: " + $filter) else . end
    | "LocalRouter " + $root + "  topology=" + (.topology.schema_version // "?") + ":" + ((.topology.digest // "missing")[0:12]),
      ($nodes | to_entries[]
        | .key as $node_index
        | .value as $node
        | ($node_index == (($nodes | length) - 1)) as $last_node
        | (if $last_node then "└─ " else "├─ " end) as $branch
        | (if $last_node then "   " else "│  " end) as $indent
        | if $node._node_kind == "surface" then
            $branch + "surface " + $node.id + "  " + (($node.paths // []) | join(", ")) + " — " + ($node.role // "")
          elif $node._node_kind == "compatibility" then
            $branch + $node.id + " [compatibility:" + ($node.status // "unknown") + "] " + ($node.name // ""),
            $indent + "├─ mount  " + (($node.mounts // []) | join(", ")),
            $indent + "├─ pool   channels eligible=" + (($node.pool.eligible // 0) | tostring),
            (($node.routes // []) | to_entries[]
              | $indent
                + (if .key == ((($node.routes // []) | length) - 1) then "└─ " else "├─ " end)
                + "api " + ((.value.methods // []) | join("/")) + " " + (.value.call_url // .value.path)
                + (if .value.status == "unsupported" then " [unsupported]" else "" end))
          else
            $branch + $node.id + " [protocol:" + ($node.status // "unknown") + "] " + ($node.name // ""),
            $indent + "├─ mount  " + ($node.mount // "unknown"),
            (if ($node.openai_v1_base_url // "") != "" then $indent + "├─ openai " + $node.openai_v1_base_url else empty end),
            (if $node.pool then
               $indent + "├─ pool   " + ($node.pool.mode // "static")
               + (if ($node.pool.source // "") != "" then "/" + $node.pool.source else "" end)
               + (if $node.pool.total != null then " eligible=" + (($node.pool.eligible // 0) | tostring) + "/" + ($node.pool.total | tostring) else "" end)
             else empty end),
            (($node.routes // []) | to_entries[]
              | $indent
                + (if (.key == ((($node.routes // []) | length) - 1)) and (($node.workflows // []) | length) == 0 then "└─ " else "├─ " end)
                + "op " + (.value.operation_key // ($node.id + "." + .value.operation_id))
                + "  " + ((.value.methods // []) | join("/")) + " " + (.value.call_url // .value.path)
                + (if (.value.transport // "http") != "http" then " [" + .value.transport + "]" else "" end)),
            (($node.workflows // []) | to_entries[]
              | $indent
                + (if .key == ((($node.workflows // []) | length) - 1) then "└─ " else "├─ " end)
                + "wf " + .value.id + "  POST " + ($node.workflow_mount + "/" + .value.id))
          end),
      "",
      "Next: lr show <pack>; Protocol Pack → lr describe/preflight/call/run; compatibility Pack → lr request"
  ' <<<"$contract"
}

command_find_operation() {
  local search_text="${1:-}"
  [[ -n "$search_text" ]] || fail "operation search requires text; use 'lr catalog' for the complete list"
  discovery | jq --arg query "$search_text" '
    def words:
      ascii_downcase | gsub("[^[:alnum:]]+"; " ") | split(" ")
      | map(select(length > 1 and . != "for" and . != "the" and . != "with" and . != "agent"));
    ($query | words) as $terms
    | ($terms | map(select(. != "free" and . != "quota" and . != "model" and . != "coding" and . != "omp"))) as $specific_terms
    | (if ($specific_terms | length) > 0 then $specific_terms else $terms end) as $search_terms
    | [.protocols[] as $protocol
      | $protocol.routes[]
      | ([
          $protocol.id, $protocol.name, $protocol.description,
          .operation_key, .operation_id, .path, .call_url, .summary,
          ((.capabilities // []) | join(" "))
        ] | join(" ") | ascii_downcase) as $haystack
      | ([ $search_terms[] | . as $term | select($haystack | contains($term)) ] | length) as $score
      | select($score > 0)
      | {
          score: $score,
          operation_key, operation_id, pack: $protocol.id,
          capabilities: (.capabilities // []), methods, call_url,
          ready: $protocol.ready, status: $protocol.status, summary
        }
    ]
    | sort_by([-.score, .operation_key])
    | {
        object: "localrouter.operation.search",
        domain: "operation",
        query: $query,
        count: length,
        matches: .,
        exact_next_step: "choose an operation_key, then run lr describe <pack> <operation> and lr preflight",
        boundary: "operation search does not search model IDs, quota, pricing, or Agent runtime configuration"
      }
  '
}

command_find_model() {
  local search_text="${1:-}"
  local result_limit="${2:-20}"
  local exact_only="${3:-false}"
  local contract search_tmp model_rows source_rows failure_rows
  contract="$(discovery)"
  search_tmp="$(mktemp -d "${TMPDIR:-/tmp}/localrouter-model-search.XXXXXX")"
  chmod 0700 "$search_tmp"
  model_rows="$search_tmp/models.jsonl"
  source_rows="$search_tmp/sources.jsonl"
  failure_rows="$search_tmp/failures.jsonl"
  : >"$model_rows"
  : >"$source_rows"
  : >"$failure_rows"
  while IFS=$'\t' read -r pack_id pack_name pack_description operation_key call_url; do
    [[ -n "$pack_id" ]] || continue
    local response parsed
    if response="$(authenticated_request GET "$base_url$call_url" 2>/dev/null)" && parsed="$(jq -c '
      if (.data | type) == "array" then .data
      elif (.models | type) == "array" then .models
      else [] end
      | map(
          if type == "string" then {id: .}
          elif type == "object" then {id: (.id // .name // .model // ""), owned_by: (.owned_by // .provider // null)}
          else {id: ""} end
        )
      | map(select(.id != ""))
    ' <<<"$response")"; then
      jq -cn --arg pack "$pack_id" --arg operation_key "$operation_key" --arg call_url "$call_url" --argjson count "$(jq 'length' <<<"$parsed")" '{pack:$pack,operation_key:$operation_key,call_url:$call_url,status:"ok",models:$count}' >>"$source_rows"
      jq -c --arg pack "$pack_id" --arg pack_name "$pack_name" --arg description "$pack_description" --arg operation_key "$operation_key" '.[] | . + {pack:$pack,pack_name:$pack_name,pack_description:$description,operation_key:$operation_key,model_key:($pack + ":" + .id)}' <<<"$parsed" >>"$model_rows"
    else
      jq -cn --arg pack "$pack_id" --arg operation_key "$operation_key" --arg call_url "$call_url" '{pack:$pack,operation_key:$operation_key,call_url:$call_url,reason:"model catalog call failed"}' >>"$failure_rows"
    fi
  done < <(jq -r '
    .protocols[] as $protocol
    | select($protocol.ready == true)
    | $protocol.routes[]
    | select((.capabilities // []) | any(. == "ai.models" or . == "openai.models"))
    | select((.methods // []) | index("GET"))
    | [$protocol.id, $protocol.name, $protocol.description, .operation_key, .call_url] | @tsv
  ' <<<"$contract")

  local output
  output="$(jq -n \
    --arg query "$search_text" \
    --argjson result_limit "$result_limit" \
    --argjson exact_only "$exact_only" \
    --argjson contract "$contract" \
    --slurpfile models "$model_rows" \
    --slurpfile sources "$source_rows" \
    --slurpfile failures "$failure_rows" '
      def words:
        ascii_downcase | gsub("[^[:alnum:]]+"; " ") | split(" ")
        | map(select(length > 1 and . != "for" and . != "the" and . != "with" and . != "agent" and . != "model"));
      ($query | ascii_downcase) as $normalized_query
      | ($query | words) as $terms
      | ($terms | map(select(. != "free" and . != "quota" and . != "coding" and . != "omp"))) as $specific_terms
      | (if ($specific_terms | length) > 0 then $specific_terms else $terms end) as $identity_terms
      | ($models | map(
          ([.pack, .id, (.owned_by // "")] | join(" ") | ascii_downcase) as $identity_haystack
          | ([.pack_description] | join(" ") | ascii_downcase) as $context_haystack
          | ([ $identity_terms[] | . as $term | select($identity_haystack | contains($term)) ] | length) as $identity_score
          | ([ $terms[] | . as $term | select($context_haystack | contains($term)) ] | length) as $context_score
          | . as $model
          | . + {
              score:($identity_score * 10 + $context_score),
              identity_score:$identity_score,
              compatible_operations: [
                $contract.protocols[]
                | select(.id == $model.pack and .ready == true)
                | .routes[]
                | select(.dynamic_inputs.model.source_operation_key == $model.operation_key)
                | {operation_key, operation_id, methods, call_url, summary}
              ]
            }
        )) as $scored_models
      | ($scored_models | map(select(
          (.id | ascii_downcase) == $normalized_query
          or (.model_key | ascii_downcase) == $normalized_query
        ))) as $exact_matches
      | (if $exact_only then $exact_matches
         elif ($query | length) == 0 then $scored_models
         elif ($exact_matches | length) > 0 then $exact_matches
         else ($scored_models | map(select(.identity_score > 0)))
         end
        | sort_by([-.score, .model_key])) as $all_matches
      | (if $result_limit == 0 then $all_matches else $all_matches[:$result_limit] end) as $matches
      | {
          object: "localrouter.model.search",
          domain: "model",
          query: $query,
          match_mode: (if $exact_only then "exact-only" elif ($query | length) == 0 then "catalog" elif ($exact_matches | length) > 0 then "exact" else "fuzzy" end),
          live: true,
          count: ($all_matches | length),
          returned: ($matches | length),
          truncated: (($matches | length) < ($all_matches | length)),
          matches: $matches,
          sources: $sources,
          failures: $failures,
          exact_next_step: (if $exact_only and ($all_matches | length) == 0
            then "no exact live model matched; refresh with lr find model --exact <pack>:<model-id> or choose a model_key returned by lr find model"
            elif (($matches | length) < ($all_matches | length))
            then "refine the query, increase --limit, or use --all; then choose one model_key and compatible operation before lr describe/preflight"
            else "choose one model_key and one published compatible_operations entry; run lr describe and lr preflight, then confirm pricing/quota with lr find pool <pack>"
            end),
          boundary: "model discovery does not configure OMP or another Agent runtime; pass the explicit Pack endpoint and model ID to that runtime separately"
        }
    ')"
  find "$search_tmp" -depth -delete
  printf '%s\n' "$output"
}

command_find_model_cli() {
  local result_limit=20
  local exact_only=false
  local -a query_parts=()
  while (($#)); do
    case "$1" in
      --exact) exact_only=true ;;
      --all) result_limit=0 ;;
      --limit)
        shift
        if [[ ! "${1:-}" =~ ^[0-9]+$ ]] || ((10#${1:-0} < 1 || 10#${1:-0} > 200)); then
          json_fail "invalid_limit" "model result limit must be between 1 and 200" "use --limit 1..200 or --all"
          return 1
        fi
        result_limit="$1"
        ;;
      --*)
        json_fail "invalid_option" "unknown model-search option: $1" "use lr find model [--exact] [--limit N|--all] [text]"
        return 1
        ;;
      *) query_parts+=("$1") ;;
    esac
    shift
  done
  command_find_model "${query_parts[*]}" "$result_limit" "$exact_only"
}

command_find_pool() {
  local search_text="${1:-}"
  local contract pool_catalog_path pool_catalog
  contract="$(discovery)"
  pool_catalog_path="$(jq -r '.documentation.pool_catalog // "/docs/pools/index.json"' <<<"$contract")"
  validate_local_path "$pool_catalog_path"
  pool_catalog="$(curl --noproxy '*' --fail-with-body --silent --show-error "$base_url$pool_catalog_path")"
  jq -n --arg query "$search_text" --argjson contract "$contract" --argjson catalog "$pool_catalog" '
    def words:
      ascii_downcase | gsub("[^[:alnum:]]+"; " ") | split(" ")
      | map(select(length > 1 and . != "for" and . != "the" and . != "with" and . != "agent" and . != "pool"));
    ($query | words) as $terms
    | ($terms | map(select(. != "free" and . != "quota" and . != "model" and . != "coding" and . != "omp"))) as $specific_terms
    | (if ($specific_terms | length) > 0 then $specific_terms else $terms end) as $search_terms
    | (((($catalog.pools // []) | map(.id)) + (($contract.protocols // []) | map(.id))) | unique) as $pool_ids
    | [$pool_ids[] as $pool_id
      | (($catalog.pools // []) | map(select(.id == $pool_id)) | first // {id:$pool_id,status:"uncatalogued",adapter:"unknown",owner:"unknown",note:"Live Pack is not indexed in the static pool catalog."}) as $pool
      | (($contract.protocols // []) | map(select(.id == $pool_id)) | first // null) as $live
      | ([
          $pool.id, ($pool.status // ""), ($pool.adapter // ""), ($pool.owner // ""), ($pool.note // ""),
          (($pool.pricing // []) | tostring),
          ($live.name // ""), ($live.description // ""), (($live.pool // {}) | tostring), (($live.pricing // {}) | tostring)
        ] | join(" ") | ascii_downcase) as $haystack
      | ([ $search_terms[] | . as $term | select($haystack | contains($term)) ] | length) as $score
      | select(($query | length) == 0 or $score > 0)
      | {
          score: $score,
          pool_id: $pool.id,
          integrated: ($live != null),
          ready: ($live.ready // false),
          runtime_status: ($live.status // "not-integrated"),
          pool: ($live.pool // null),
          catalog_status: ($pool.status // "unknown"),
          adapter: ($pool.adapter // "none"),
          owner: ($pool.owner // "unknown"),
          pricing: ($live.pricing.entries // $pool.pricing // []),
          note: ($pool.note // "")
        }
    ]
    | sort_by([-.score, .pool_id])
    | {
        object: "localrouter.pool.search",
        domain: "pool",
        query: $query,
        count: length,
        matches: .,
        exact_next_step: "inspect ready, pool eligibility, pricing status and quota freshness separately before selecting an operation",
        boundary: "unknown or missing quota is not zero and does not prove a model is free"
      }
  '
}

command_find() {
  local domain="${1:-}"
  if [[ "$domain" == "-h" || "$domain" == "--help" || "${2:-}" == "-h" || "${2:-}" == "--help" ]]; then
    usage
    return 0
  fi
  case "$domain" in
    operation|operations)
      shift
      command_find_operation "$*"
      ;;
    model|models)
      shift
      command_find_model_cli "$@"
      ;;
    pool|pools|quota|pricing)
      shift
      command_find_pool "$*"
      ;;
    "")
      fail "find requires text or a domain: operation, model, pool"
      ;;
    *)
      local search_text="$*" search_tmp operations_file models_file pools_file
      search_tmp="$(mktemp -d "${TMPDIR:-/tmp}/localrouter-resource-search.XXXXXX")"
      chmod 0700 "$search_tmp"
      operations_file="$search_tmp/operations.json"
      models_file="$search_tmp/models.json"
      pools_file="$search_tmp/pools.json"
      command_find_operation "$search_text" >"$operations_file"
      command_find_model "$search_text" 20 false >"$models_file"
      command_find_pool "$search_text" >"$pools_file"
      local output
      output="$(jq -n --arg query "$search_text" --slurpfile operations "$operations_file" --slurpfile models "$models_file" --slurpfile pools "$pools_file" '
        ($operations[0]) as $operation_result | ($models[0]) as $model_result | ($pools[0]) as $pool_result | {
        object:"localrouter.resource.search",
        query:$query,
        domains:{operation:$operation_result,model:$model_result,pool:$pool_result},
        no_match:(($operation_result.count + $model_result.count + $pool_result.count) == 0),
        next_actions:[
          "Use lr find operation <intent> for callable capabilities",
          "Use lr find model <name> for current upstream model IDs",
          "Use lr find pool <provider> for readiness, quota and pricing",
          "Configure OMP or another Agent runtime only after choosing an exact operation_key and model_key"
        ]
      }')"
      find "$search_tmp" -depth -delete
      printf '%s\n' "$output"
      ;;
  esac
}

validate_pack_id() {
  local value="$1"
  [[ "$value" =~ ^[a-z][a-z0-9-]{1,31}$ ]] || fail "invalid Pack ID: $value"
}

validate_operation_id() {
  local value="$1"
  [[ "$value" =~ ^[a-z][a-z0-9._-]{1,63}$ ]] || fail "invalid operation or workflow ID: $value"
}

normalize_operation_selector() {
  local pack_id="$1"
  local selector="$2"
  if [[ "$selector" == "$pack_id".* ]]; then
    selector="${selector#${pack_id}.}"
  fi
  printf '%s\n' "$selector"
}

command_resolve() {
  local query="${1:-}"
  local limit="${2:-100}"
  [[ -n "$query" ]] || fail "resolve requires a capability or intent"
  [[ "$limit" =~ ^[0-9]+$ ]] && ((limit >= 1 && limit <= 200)) || fail "resolve limit must be between 1 and 200"
  local request
  request="$(jq -cn --arg query "$query" --argjson limit "$limit" '{query:$query,limit:$limit}')"
  authenticated_request POST "$base_url/agent/resolve" "$request" | jq .
}

command_catalog() {
  local pack_id=""
  local result_limit=20
  while (($#)); do
    case "$1" in
      --all) result_limit=0 ;;
      --limit)
        shift
        if [[ ! "${1:-}" =~ ^[0-9]+$ ]] || ((10#${1:-0} < 1 || 10#${1:-0} > 200)); then
          json_fail "invalid_limit" "catalog result limit must be between 1 and 200" "use --limit 1..200 or --all"
          return 1
        fi
        result_limit="$1"
        ;;
      --*)
        json_fail "invalid_option" "unknown catalog option: $1" "use lr catalog [pack] [--limit N|--all]"
        return 1
        ;;
      *)
        if [[ -n "$pack_id" ]]; then
          json_fail "invalid_arguments" "catalog accepts at most one Pack ID" "use lr catalog [pack] [--limit N|--all]"
          return 1
        fi
        pack_id="$1"
        ;;
    esac
    shift
  done
  local request_url="$base_url/agent/operations"
  if [[ -n "$pack_id" ]]; then
    validate_pack_id "$pack_id"
    request_url+="?pack=$pack_id"
  fi
  authenticated_request GET "$request_url" | jq --argjson limit "$result_limit" '
    .operations as $all
    | (if $limit == 0 then $all else $all[:$limit] end) as $returned
    | .operations = $returned
    | .count = ($all | length)
    | .returned = ($returned | length)
    | .truncated = (($returned | length) < ($all | length))
    | .next_action = (if .truncated then "narrow with lr catalog <pack>, increase --limit, or use --all" else "choose an operation_key, then use lr describe and lr preflight" end)
  '
}

command_compare() {
  (($# >= 2 && $# <= 50)) || fail "compare requires between 2 and 50 operation keys"
  local operation_key pack_id operation_id
  declare -A seen_operation_keys=()
  for operation_key in "$@"; do
    [[ "$operation_key" == *.* ]] || fail "invalid operation key: $operation_key"
    pack_id="${operation_key%%.*}"
    operation_id="${operation_key#*.}"
    validate_pack_id "$pack_id"
    validate_operation_id "$operation_id"
    [[ -z "${seen_operation_keys[$operation_key]+x}" ]] || fail "duplicate operation key: $operation_key"
    seen_operation_keys[$operation_key]=1
  done
  local request
  request="$(jq -cn --args '$ARGS.positional | {operation_keys:.}' "$@")"
  authenticated_request POST "$base_url/agent/compare" "$request" | jq .
}

command_describe() {
  local pack_id="${1:-}"
  local operation_id="${2:-}"
  [[ -n "$pack_id" && -n "$operation_id" ]] || fail "describe requires a Pack ID and operation ID"
  validate_pack_id "$pack_id"
  operation_id="$(normalize_operation_selector "$pack_id" "$operation_id")"
  validate_operation_id "$operation_id"
  authenticated_request GET "$base_url/agent/operations/$pack_id/$operation_id" | jq 'if (.data | type) == "object" then .data else . end'
}

command_preflight() {
  local pack_id="${1:-}"
  local operation_id="${2:-}"
  local input_argument="${3-}"
  local path_parameters_argument="${4-}"
  local query_parameters_argument="${5-}"
  [[ -n "$pack_id" && -n "$operation_id" ]] || fail "preflight requires a Pack ID and operation ID"
  validate_pack_id "$pack_id"
  operation_id="$(normalize_operation_selector "$pack_id" "$operation_id")"
  validate_operation_id "$operation_id"
  [[ -n "$input_argument" ]] || input_argument='{}'
  [[ -n "$path_parameters_argument" ]] || path_parameters_argument='{}'
  [[ -n "$query_parameters_argument" ]] || query_parameters_argument='{}'
  local input path_parameters query_parameters request
  input="$(json_argument "$input_argument")"
  path_parameters="$(json_argument "$path_parameters_argument")"
  query_parameters="$(json_argument "$query_parameters_argument")"
  [[ "$(jq -r 'type' <<<"$path_parameters")" = "object" ]] || fail "path parameters must be a JSON object"
  [[ "$(jq -r 'type' <<<"$query_parameters")" = "object" ]] || fail "query parameters must be a JSON object"
  request="$(jq -cn --arg pack "$pack_id" --arg operation "$operation_id" --argjson input "$input" --argjson path_parameters "$path_parameters" --argjson query_parameters "$query_parameters" '{pack:$pack,operation:$operation,input:$input,path_parameters:$path_parameters,query_parameters:$query_parameters}')"
  local response
  response="$(authenticated_request POST "$base_url/agent/preflight" "$request")"
  jq . <<<"$response"
  [[ "$(jq -r '.ok // false' <<<"$response")" = "true" ]] || return 1
}

command_whoami() {
  authenticated_request GET "$base_url/agent/whoami" | jq .
}

command_show() {
  local pack_id="${1:-}"
  [[ -n "$pack_id" ]] || fail "show requires a Pack ID"
  local result
  result="$(discovery | jq --arg id "$pack_id" '
    ([.compatibility_packs[]? | select(.id == $id)]
      + [.protocols[] | select(.id == $id) | {id, pack_key, kind, name, description, ready, status, status_label, mount, openai_v1_base_url, workflow_mount, pool, docs, guides, routes: [.routes[] | {operation_key, operation_id, operation_id_role, operation_id_is_url, methods, path, call_url, call, request_example_role, dynamic_inputs, summary, streaming, transport}]}])
  ')"
  if [[ "$(jq 'length' <<<"$result")" = "0" ]]; then
    json_fail "pack_not_found" "unknown Pack: $pack_id" "run lr tree or lr find <intent>, then use a published Pack ID"
    return 1
  fi
  [[ "$(jq 'length' <<<"$result")" = "1" ]] || fail "Pack ID is ambiguous across compatibility and Protocol Packs: $pack_id"
  jq '.[0]' <<<"$result"
}

command_docs() {
  local pack_id="${1:-}"
  [[ -n "$pack_id" ]] || fail "docs requires a Pack ID"
  local markdown_path
  markdown_path="$(discovery | jq -r --arg id "$pack_id" '.protocols[] | select(.id == $id) | .docs.markdown // empty')"
  [[ -n "$markdown_path" ]] || fail "unknown Pack or missing Markdown guide: $pack_id"
  validate_local_path "$markdown_path"
  curl --noproxy '*' --fail-with-body --silent --show-error "$base_url$markdown_path"
}

command_runtime_openai() {
  local pack_id="${1:-}"
  local model_id="${2:-}"
  [[ -n "$pack_id" && -n "$model_id" ]] || fail "runtime-openai requires a Pack ID and exact model ID"
  validate_pack_id "$pack_id"

  local contract binding model_search exact_model
  contract="$(discovery)"
  binding="$(jq -c --arg pack "$pack_id" '
    [.protocols[] | select(.id == $pack) | {
      ready, status, mount, openai_v1_base_url,
      models: ([.routes[] | select(.path == "/models" and (.methods | index("GET")))] | length),
      chat: ([.routes[] | select(.path == "/chat/completions" and (.methods | index("POST")))] | length)
    }] | if length == 1 then .[0] else empty end
  ' <<<"$contract")"
  [[ -n "$binding" ]] || fail "unknown Pack: $pack_id"
  [[ "$(jq -r '.ready and (.models == 1) and (.chat == 1)' <<<"$binding")" = "true" ]] || fail "Pack is not a ready OpenAI-compatible runtime mount with GET /models and POST /chat/completions"

  model_search="$(command_find_model "$pack_id:$model_id" 20 true)"
  exact_model="$(jq -c --arg pack "$pack_id" --arg model "$model_id" '
    [.matches[] | select(.pack == $pack and .id == $model)] | if length == 1 then .[0] else empty end
  ' <<<"$model_search")"
  [[ -n "$exact_model" ]] || fail "model is not currently advertised by $pack_id: $model_id"

  local runtime_base_url
  runtime_base_url="$(jq -r '.openai_v1_base_url // empty' <<<"$binding")"
  [[ -n "$runtime_base_url" ]] || fail "running LocalRouter does not publish an OpenAI v1 Base URL for this Pack; install and restart a runtime with contract schema 7 or newer"

  jq -n \
    --arg pack "$pack_id" \
    --arg model "$model_id" \
    --arg base_url "$base_url$runtime_base_url" \
    --arg api_token_file "$api_token_file" \
    --arg operation_key "$(jq -r '.compatible_operations[0].operation_key' <<<"$exact_model")" \
    '{
      object: "localrouter.runtime.openai",
      pack: $pack,
      adapter: "openai-completions",
      base_url: $base_url,
      model: $model,
      operation_key: $operation_key,
      api_token_file: $api_token_file,
      route_contract: "use this published Base URL unchanged; the runtime appends /models and /chat/completions",
      credential_value_exported: false
    }'
}

command_call() {
  local pack_id="${1:-}"
  local operation_id="${2:-}"
  local body_input="${3-}"
  [[ -n "$body_input" ]] || body_input='{}'
  [[ -n "$pack_id" && -n "$operation_id" ]] || fail "call requires a Pack ID and operation ID"
  validate_pack_id "$pack_id"
  operation_id="$(normalize_operation_selector "$pack_id" "$operation_id")"
  validate_operation_id "$operation_id"
  local binding
  binding="$(discovery | jq -c --arg pack "$pack_id" --arg operation "$operation_id" '
    [.protocols[] | select(.id == $pack) as $protocol
      | $protocol.routes[] | select(.operation_id == $operation)
      | {ready: $protocol.ready, status: $protocol.status, path: .call_url, method: .call.default_method}]
  ')"
  if [[ "$(jq 'length' <<<"$binding")" != "1" ]]; then
    json_fail "operation_not_found" "operation not found or ambiguous: $pack_id/$operation_id" "run lr show $pack_id or lr find operation <intent>, then use the published operation_id"
    return 1
  fi
  local request_path method body
  request_path="$(jq -r '.[0].path' <<<"$binding")"
  method="$(jq -r '.[0].method' <<<"$binding")"
  if [[ "$request_path" == *'{'* ]]; then
    json_fail "path_parameters_required" "operation needs path parameters" "use lr mcp-list to inspect the schema, then lr mcp-call with the required path parameters"
    return 1
  fi
  body="$(json_argument "$body_input")"
  if [[ "$method" = "GET" && "$body" != "{}" ]]; then
    json_fail "query_parameters_required" "GET operation bodies are not supported" "use lr request with an explicit published call_url and query string, or lr mcp-call"
    return 1
  fi
  authenticated_request "$method" "$base_url$request_path" "$body"
}

command_run() {
  local pack_id="${1:-}"
  local target_id="${2:-}"
  local body_input="${3-}"
  [[ -n "$body_input" ]] || body_input='{}'
  [[ -n "$pack_id" && -n "$target_id" ]] || fail "run requires a Pack ID and operation or workflow ID"
  validate_pack_id "$pack_id"
  validate_operation_id "$target_id"
  local is_workflow body
  is_workflow="$(discovery | jq -r --arg pack "$pack_id" --arg workflow "$target_id" 'any(.protocols[] | select(.id == $pack) | .workflows[]?; .id == $workflow)')"
  if [[ "$is_workflow" = "true" ]]; then
    body="$(json_argument "$body_input")"
    authenticated_request POST "$base_url/w/$pack_id/$target_id" "$body"
    return
  fi
  target_id="$(normalize_operation_selector "$pack_id" "$target_id")"
  command_call "$pack_id" "$target_id" "$body_input"
}

command_watch() {
  local pack_id="${1:-}"
  local workflow_id="${2:-}"
  local job_id="${3:-}"
  local timeout_seconds="${4:-0}"
  [[ -n "$pack_id" && -n "$workflow_id" && -n "$job_id" ]] || fail "watch requires a Pack ID, workflow ID and job ID"
  validate_pack_id "$pack_id"
  validate_operation_id "$workflow_id"
  [[ "$job_id" =~ ^job-[a-zA-Z0-9_-]{8,128}$ ]] || fail "invalid workflow job ID"
  [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || fail "watch timeout must be zero or a positive number of seconds"
  local poll_interval="${LOCALROUTER_WATCH_INTERVAL_SECONDS:-2}"
  [[ "$poll_interval" =~ ^[0-9]+$ ]] && ((poll_interval >= 1 && poll_interval <= 3600)) || fail "LOCALROUTER_WATCH_INTERVAL_SECONDS must be between 1 and 3600"
  local watch_started_epoch response state
  watch_started_epoch="$(date +%s)"
  while true; do
    response="$(authenticated_request GET "$base_url/w/$pack_id/$workflow_id/$job_id")"
    state="$(jq -r '.data.state // empty' <<<"$response")"
    [[ -n "$state" ]] || fail "workflow response did not contain data.state"
    if [[ "${LOCALROUTER_WATCH_PROGRESS:-0}" = "1" ]]; then
      jq -r '"lr: workflow state=" + .data.state + " attempts=" + ((.data.attempts // 0)|tostring)' <<<"$response" >&2
    fi
    case "$state" in
      succeeded)
        jq . <<<"$response"
        return 0
        ;;
      failed|cancelled|timed_out)
        jq . <<<"$response"
        return 1
        ;;
    esac
    if ((timeout_seconds > 0 && $(date +%s) - watch_started_epoch >= timeout_seconds)); then
      jq -n --arg code "watch_timeout" --arg state "$state" --arg pack "$pack_id" --arg workflow "$workflow_id" --arg job "$job_id" '{success:false,code:$code,retryable:true,state:$state,pack:$pack,workflow:$workflow,job:$job,next_action:"resume lr watch with the same job ID"}' >&2
      return 1
    fi
    sleep "$poll_interval"
  done
}

command_cancel() {
  local pack_id="${1:-}"
  local workflow_id="${2:-}"
  local job_id="${3:-}"
  [[ -n "$pack_id" && -n "$workflow_id" && -n "$job_id" ]] || fail "cancel requires a Pack ID, workflow ID and job ID"
  validate_pack_id "$pack_id"
  validate_operation_id "$workflow_id"
  [[ "$job_id" =~ ^job-[a-zA-Z0-9_-]{8,128}$ ]] || fail "invalid workflow job ID"
  authenticated_request DELETE "$base_url/w/$pack_id/$workflow_id/$job_id" | jq .
}

command_request() {
  local method="${1:-}"
  local request_path="${2:-}"
  local body_input="${3:-}"
  [[ -n "$method" && -n "$request_path" ]] || fail "request requires a method and path"
  method="${method^^}"
  validate_local_path "$request_path"
  local body=""
  if [[ -n "$body_input" ]]; then
    body="$(json_argument "$body_input")"
  fi
  authenticated_request "$method" "$base_url$request_path" "$body"
}

command_mcp_list() {
  local search_text="${1:-}"
  local response
  response="$(authenticated_request POST "$mcp_url" '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}')"
  local matches
  matches="$(jq -r --arg query "${search_text,,}" '
    if .error then error(.error.message) else .result.tools[] end
    | select($query == "" or ((.name + " " + .description) | ascii_downcase | contains($query)))
    | [.name, .description, (.annotations.readOnlyHint // false), (.annotations.destructiveHint // false)]
    | @tsv
  ' <<<"$response")"
  [[ -n "$matches" ]] || fail "no ready MCP tool matched: $search_text"
  printf 'name\tdescription\tread_only\tdestructive\n%s\n' "$matches"
}

command_mcp_call() {
  local tool_name="${1:-}"
  local arguments_input="${2-}"
  [[ -n "$arguments_input" ]] || arguments_input='{}'
  [[ -n "$tool_name" ]] || fail "mcp-call requires a tool name"
  local arguments request
  arguments="$(json_argument "$arguments_input")"
  request="$(jq -cn --arg name "$tool_name" --argjson arguments "$arguments" '{jsonrpc:"2.0",id:1,method:"tools/call",params:{name:$name,arguments:$arguments}}')"
  local response
  response="$(authenticated_request POST "$mcp_url" "$request")"
  if jq -e '.error != null' >/dev/null <<<"$response"; then
    jq -r '"lr: MCP error " + (.error.code | tostring) + ": " + .error.message' <<<"$response" >&2
    return 1
  fi
  jq '.result' <<<"$response"
}

command_manage_list() {
  local search_text="${1:-}"
  local response
  response="$(maintenance_request POST "$maintenance_mcp_url" '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}')"
  local matches
  matches="$(jq -r --arg query "${search_text,,}" '
    if .error then error(.error.message) else .result.tools[] end
    | select($query == "" or ((.name + " " + .description) | ascii_downcase | contains($query)))
    | [.name, .description, (.annotations.readOnlyHint // false), (.annotations.destructiveHint // false)]
    | @tsv
  ' <<<"$response")"
  [[ -n "$matches" ]] || fail "no maintenance tool matched: $search_text"
  printf '%s\n' "$matches"
}

command_manage_status() {
  local contract
  contract="$(discovery)"
  jq -n \
    --arg lane "$(if [[ -n "$maintainer_token_file" ]]; then printf 'agent-token'; else printf 'delegated-operator'; fi)" \
    --argjson contract "$contract" '
      {
        object: "localrouter.maintenance.status",
        selected_lane: $lane,
        agent_maintenance_enabled: ($contract.maintenance.auth.agent_token.enabled // false),
        prerequisite: (if $lane == "agent-token"
          then "discovery must enable maintenance.auth.agent_token and the supplied locator must contain a distinct localrouter.maintain Token"
          else "explicit user delegation is required for the named local operator change"
          end),
        credential_value_exported: false,
        next: "use lr manage-list, then open an isolated draft and apply only its reviewed exact digest"
      }'
}

command_manage_call() {
  local tool_name="${1:-}"
  local arguments_input="${2-}"
  [[ -n "$arguments_input" ]] || arguments_input='{}'
  [[ -n "$tool_name" ]] || fail "manage-call requires a tool name"
  local arguments request response
  arguments="$(json_argument "$arguments_input")"
  request="$(jq -cn --arg name "$tool_name" --argjson arguments "$arguments" '{jsonrpc:"2.0",id:1,method:"tools/call",params:{name:$name,arguments:$arguments}}')"
  response="$(maintenance_request POST "$maintenance_mcp_url" "$request")"
  if jq -e '.error != null' >/dev/null <<<"$response"; then
    jq -r '"lr: maintenance MCP error " + (.error.code | tostring) + ": " + .error.message' <<<"$response" >&2
    return 1
  fi
  if jq -e '.result.isError == true' >/dev/null <<<"$response"; then
    jq '.result.structuredContent' <<<"$response" >&2
    return 1
  fi
  jq '.result.structuredContent // .result' <<<"$response"
}

command_env() {
  jq -n \
    --arg base_url "$base_url" \
    --arg discovery_url "$discovery_url" \
    --arg mcp_url "$mcp_url" \
    --arg maintenance_mcp_url "$maintenance_mcp_url" \
    --arg api_token_file "$api_token_file" \
    --arg admin_token_file "$admin_token_file" \
    --arg maintainer_token_file "$maintainer_token_file" \
    '{base_url:$base_url, discovery_url:$discovery_url, mcp_url:$mcp_url, maintenance_mcp_url:$maintenance_mcp_url, api_token_file:$api_token_file, maintenance_auth:(if $maintainer_token_file == "" then "administrator" else "agent-token" end), admin_token_file:$admin_token_file, maintainer_token_file:(if $maintainer_token_file == "" then null else $maintainer_token_file end), token_value_exported:false}'
}

require_command curl
require_command jq
require_command stat
validate_loopback_url "$base_url"
validate_loopback_url "$discovery_url"
validate_loopback_url "$mcp_url"
validate_loopback_url "$maintenance_mcp_url"

command_name="${1:-help}"
shift || true
if [[ "$command_name" != "help" && ("${1:-}" == "-h" || "${1:-}" == "--help") ]]; then
  usage
  exit 0
fi
case "$command_name" in
  status) command_status "$@" ;;
  tree) command_tree "$@" ;;
  find) command_find "$@" ;;
  models) command_find_model_cli "$@" ;;
  pools) command_find_pool "$*" ;;
  catalog) command_catalog "$@" ;;
  resolve) command_resolve "$@" ;;
  compare) command_compare "$@" ;;
  show) command_show "$@" ;;
  describe) command_describe "$@" ;;
  docs) command_docs "$@" ;;
  runtime-openai) command_runtime_openai "$@" ;;
  preflight) command_preflight "$@" ;;
  call) command_call "$@" ;;
  run) command_run "$@" ;;
  watch) command_watch "$@" ;;
  cancel) command_cancel "$@" ;;
  request) command_request "$@" ;;
  mcp-list) command_mcp_list "$@" ;;
  mcp-call) command_mcp_call "$@" ;;
  whoami) command_whoami "$@" ;;
  manage-status) command_manage_status "$@" ;;
  manage-list) command_manage_list "$@" ;;
  manage-call) command_manage_call "$@" ;;
  env) command_env "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; fail "unknown command: $command_name" ;;
esac
