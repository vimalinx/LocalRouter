  exec) command_exec "$@" ;;
  result) command_result "$@" ;;
  run) command_run "$@" ;;
  watch) command_watch "$@" ;;
  cancel) command_cancel "$@" ;;
  request) command_request "$@" ;;
  mcp-list) command_mcp_list "$@" ;;
