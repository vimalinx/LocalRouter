{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localrouter.invalid/schema/protocol-template-v1.json",
  "title": "LocalRouter protocol template v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "description", "enabled", "base_url", "auth", "routes"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "enabled": {"type": "boolean"},
    "base_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["none", "bearer", "header", "dual"]},
        "header": {"type": "string"},
        "secret_file": {"type": "string"}
      }
    },
    "forward_headers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "response_headers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["methods", "path", "summary"],
        "properties": {
          "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
          "capabilities": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"}, "uniqueItems": true},
          "methods": {"type": "array", "minItems": 1, "items": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]}, "uniqueItems": true},
          "path": {"type": "string", "pattern": "^/"},
          "summary": {"type": "string", "minLength": 1},
          "streaming": {"type": "boolean"},
          "request_example": {},
          "request_schema": {"type": ["object", "boolean"]},
          "response_schema": {"type": ["object", "boolean"]}
        }
      }
    }
  }
}
