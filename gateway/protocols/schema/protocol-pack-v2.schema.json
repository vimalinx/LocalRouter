{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localrouter.invalid/schema/protocol-pack-v2.json",
  "title": "LocalRouter Protocol Pack v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "description", "enabled", "base_url", "auth", "routes"],
  "properties": {
    "schema_version": {"const": "2"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "enabled": {"type": "boolean"},
    "base_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "auth": {"$ref": "#/$defs/auth"},
    "pool": {"$ref": "#/$defs/pool"},
    "forward_headers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "response_headers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/route"}
    },
    "workflows": {
      "type": "array",
      "items": {"$ref": "#/$defs/workflow"}
    },
    "pricing": {"$ref": "#/$defs/pricing"}
  },
  "$defs": {
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["none", "bearer", "header", "cookie", "dual"]},
        "header": {"type": "string"},
        "secret_file": {"type": "string"},
        "value_template": {"type": "string"}
      }
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["local", "external"]},
        "credentials_file": {"type": "string"},
        "strategy": {"enum": ["round-robin", "lru", "least-inflight", "balance-aware", "smooth-weighted"]},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_inflight_per_credential": {"type": "integer", "minimum": 0, "maximum": 10000},
        "min_balance": {"type": "number"},
        "unauthorized_action": {"enum": ["disable", "cooldown"]},
        "unauthorized_cooldown_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "rate_limit_cooldown_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "transient_cooldown_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "quota_stale_after_seconds": {"type": "integer", "minimum": 60, "maximum": 31536000},
        "source": {"$ref": "#/$defs/pool_source"}
      }
    },
    "pool_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "locator_file", "id_path", "secret_path"],
      "properties": {
        "format": {"enum": ["json", "jsonl"]},
        "locator_file": {"type": "string"},
        "records_path": {"type": "string"},
        "id_path": {"type": "string"},
        "secret_path": {"type": "string"},
        "secret_codec": {"enum": ["plain", "cookie-list-json", "json-fields"]},
        "secret_selector": {"type": "string"},
        "secret_fields": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "disabled_path": {"type": "string"},
        "eligible_path": {"type": "string"},
        "balance_path": {"type": "string"},
        "quota_total_path": {"type": "string"},
        "quota_remaining_path": {"type": "string"},
        "quota_used_path": {"type": "string"},
        "quota_unit_path": {"type": "string"},
        "quota_status_path": {"type": "string"},
        "quota_checked_at_path": {"type": "string"},
        "weight_path": {"type": "string"},
        "priority_path": {"type": "string"},
        "expires_at_path": {"type": "string"}
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pricing_entry"}}
      }
    },
    "pricing_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "status", "source_url", "source_type", "checked_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "scope": {"enum": ["operation", "model", "platform"]},
        "label": {"type": "string", "minLength": 1},
        "amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "minLength": 1, "maxLength": 16},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "free_tier": {"type": "string", "minLength": 1},
        "status": {"enum": ["confirmed", "estimated", "unknown", "unpublished"]},
        "source_url": {"type": "string", "pattern": "^https?://"},
        "source_type": {"enum": ["official-pricing-page", "official-docs", "official-homepage", "official-console", "official-api-observed", "maintainer-verified"]},
        "checked_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "json_transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set": {"type": "object", "additionalProperties": true},
        "rename": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
          }
        },
        "remove": {"type": "array", "items": {"type": "string"}},
        "extract": {"type": "string"},
        "envelope": {"type": "string"}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "methods", "path", "summary"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "capabilities": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"}, "uniqueItems": true},
        "methods": {"type": "array", "minItems": 1, "items": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]}, "uniqueItems": true},
        "path": {"type": "string", "pattern": "^/"},
        "upstream_path": {"type": "string", "pattern": "^/"},
        "summary": {"type": "string", "minLength": 1},
        "streaming": {"type": "boolean"},
        "request_example": {},
        "request_schema": {"type": ["object", "boolean"]},
        "response_schema": {"type": ["object", "boolean"]},
        "request_transform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "json": {"$ref": "#/$defs/json_transform"},
            "headers": {"type": "object", "additionalProperties": {"type": "string"}},
            "query": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "response_transform": {"$ref": "#/$defs/json_transform"},
        "affinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "response_json_path": {"type": "string"},
            "request_path_param": {"type": "string"},
            "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 2592000}
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "create_operation", "poll_operation", "resource_id_path", "status_path", "pending_values", "success_values", "failure_values"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "name": {"type": "string", "minLength": 1},
        "create_operation": {"type": "string"},
        "poll_operation": {"type": "string"},
        "cancel_operation": {"type": "string"},
        "resource_id_path": {"type": "string"},
        "status_path": {"type": "string"},
        "result_path": {"type": "string"},
        "pending_values": {"type": "array", "items": {"type": "string"}},
        "running_values": {"type": "array", "items": {"type": "string"}},
        "success_values": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "failure_values": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "poll_interval_ms": {"type": "integer", "minimum": 250, "maximum": 300000},
        "max_poll_attempts": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    }
  }
}
