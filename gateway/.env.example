# LocalRouter always refuses non-loopback listen addresses.
LOCAL_GATEWAY_HOST=127.0.0.1
LOCAL_GATEWAY_PORT=8317

# Defaults to $XDG_DATA_HOME/localrouter. Keep credentials and SQLite private.
# LOCAL_GATEWAY_DATA_DIR=/absolute/private/path

# Mutable runtime state defaults to $XDG_STATE_HOME/localrouter.
# LOCAL_GATEWAY_STATE_DIR=/absolute/private/path

# Validated custom REST/SSE templates default to
# $XDG_CONFIG_HOME/localrouter/protocols and are seeded from the binary.
# LOCAL_GATEWAY_PROTOCOL_DIR=/absolute/path/to/protocols

# Reserved transient cache defaults to $XDG_CACHE_HOME/localrouter.
# LOCAL_GATEWAY_CACHE_DIR=/absolute/private/path
